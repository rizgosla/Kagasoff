---
/** Real photograph with a graceful fallback ground.
    Size it with the `class` prop (e.g. class="min-h-[480px] rounded-[4px]").
    Use `dark` on navy grounds so the fallback ground matches. */
interface Props {
  src: string;
  alt: string;
  dark?: boolean;
  /** object-position, e.g. "50% 30%" */
  position?: string;
  class?: string;
}

const { src, alt, dark = false, position = '50% 40%', class: cls = '' } = Astro.props;
---

<div class:list={['relative overflow-hidden', dark ? 'bg-navydark' : 'bg-cream', cls]}>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover"
    style={`object-position:${position}`}
  />
</div>
