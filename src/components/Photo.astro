---
/** Real photograph with a graceful fallback ground.
    Size it with the `class` prop (e.g. class="min-h-[480px] rounded-md").
    Use `dark` on ink grounds so the fallback ground matches.
    Set `priority` on the above-the-fold hero image only — it swaps lazy
    loading for eager + high fetch priority, which is what LCP measures. */
interface Props {
  src: string;
  alt: string;
  dark?: boolean;
  /** object-position, e.g. "50% 30%" */
  position?: string;
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  dark = false,
  position = '50% 40%',
  priority = false,
  class: cls = '',
} = Astro.props;
---

<div class:list={['relative overflow-hidden', dark ? 'bg-inkdeep' : 'bg-sand', cls]}>
  <img
    src={src}
    alt={alt}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="absolute inset-0 h-full w-full object-cover"
    style={`object-position:${position}`}
  />
</div>
