---
/** Sticky ink-on-paper header — "Plain English, legal structure."
    Serif wordmark, plain nav words (Practice areas / Attorney / Contact), a
    keyboard-accessible Practice-areas disclosure sourced from
    practiceAreas.ts, the tel: phone link, and the clay "Request a
    consultation" CTA. Mobile menu is a real button with aria-expanded. */
import { practiceAreas } from '../data/practiceAreas';

const nav = [
  { label: 'Attorney', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
const practiceActive = path.startsWith('/practice');
---

<header class="sticky top-0 z-40 border-b border-line bg-paper">
  <div class="mx-auto flex max-w-page items-center justify-between gap-sm px-md py-sm md:gap-md md:px-xl md:py-md">
    <!-- Wordmark -->
    <a href="/" class="flex min-h-11 items-center font-serif text-lead font-medium leading-tight text-ink md:text-h3">
      Kagasoff Law Firm, A.P.C.
    </a>

    <!-- Primary nav (desktop) -->
    <nav aria-label="Primary" class="hidden items-center gap-md font-sans text-meta md:flex">
      <!-- Practice areas — keyboard-accessible disclosure, not hover-only -->
      <details class="group relative">
        <summary
          class:list={[
            'flex min-h-11 cursor-pointer list-none items-center gap-2xs border-b pb-2xs marker:content-none [&::-webkit-details-marker]:hidden',
            practiceActive ? 'border-clay text-clay' : 'border-transparent text-ink hover:text-clay',
          ]}
        >
          Practice areas
          <svg width="10" height="10" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="shrink-0 transition-transform group-open:rotate-180">
            <path d="M5.293 7.293a1 1 0 0 1 1.414 0L10 10.586l3.293-3.293a1 1 0 1 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 0-1.414Z" fill="currentColor" />
          </svg>
        </summary>
        <div class="absolute left-0 top-full z-50 mt-xs min-w-64 rounded-md border border-line bg-paper py-xs shadow-card">
          {
            practiceAreas.map((a) => (
              <a
                href={`/practice/${a.slug}/`}
                class="flex min-h-11 items-center px-md py-sm text-meta text-ink hover:bg-sand hover:text-clay"
              >
                {a.name}
              </a>
            ))
          }
        </div>
      </details>

      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center border-b pb-2xs',
              isActive(item.href) ? 'border-clay text-clay' : 'border-transparent text-ink hover:text-clay',
            ]}
          >
            {item.label}
          </a>
        ))
      }

      <!-- Phone -->
      <a href="tel:+16572184947" class="flex min-h-11 items-center gap-2xs text-ink hover:text-clay">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        (657) 218-4947
      </a>

      <!-- CTA -->
      <a
        href="/contact/"
        class="lift btn-clay flex min-h-11 items-center rounded-md bg-clay px-md font-medium"
      >
        Request a consultation
      </a>
    </nav>

    <!-- Mobile actions: persistent tap-to-call + menu toggle -->
    <div class="flex items-center gap-sm md:hidden">
      <a
        href="tel:+16572184947"
        aria-label="Call (657) 218-4947"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-md text-ink hover:text-clay"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
      </a>

      <!-- Mobile menu toggle -->
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-11 w-11 shrink-0 items-center justify-center text-ink"
      >
        <svg id="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="menu-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" class="hidden">
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" hidden class="border-t border-line bg-paper md:hidden">
    <nav aria-label="Primary" class="flex flex-col gap-2xs px-lg py-md font-sans text-meta">
      <div class="mb-2xs mt-sm px-2xs text-eyebrow uppercase text-stone">Practice areas</div>
      {
        practiceAreas.map((a) => (
          <a href={`/practice/${a.slug}/`} class="flex min-h-11 items-center rounded-md px-2xs text-ink hover:text-clay">
            {a.name}
          </a>
        ))
      }

      <div class="mt-sm border-t border-line pt-sm">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={['flex min-h-11 items-center rounded-md px-2xs', isActive(item.href) ? 'text-clay' : 'text-ink hover:text-clay']}
            >
              {item.label}
            </a>
          ))
        }
        <a href="tel:+16572184947" class="flex min-h-11 items-center gap-2xs rounded-md px-2xs text-ink hover:text-clay">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
          (657) 218-4947
        </a>
      </div>

      <a
        href="/contact/"
        class="btn-clay mt-sm flex min-h-11 items-center justify-center rounded-md bg-clay px-md font-medium"
      >
        Request a consultation
      </a>
    </nav>
  </div>
</header>

<style is:global>
  /* Keeps the sticky header from covering the skip-link / in-page jump
     target. #main lives in BaseLayout; scoped styles can't reach it, so
     this rule is intentionally global. */
  #main {
    scroll-margin-top: var(--spacing-3xl);
  }
</style>

<script>
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  const openMobileMenu = () => {
    if (!mobileMenu || !mobileToggle) return;
    mobileMenu.hidden = false;
    mobileToggle.setAttribute('aria-expanded', 'true');
    mobileToggle.setAttribute('aria-label', 'Close menu');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    // Lock body scroll while the panel covers the page. overflow-x:clip is
    // set directly on <body> in global.css (unlayered, so it always wins);
    // this utility only adds overflow-y, so the sticky header is unaffected.
    document.body.classList.add('overflow-hidden');
  };

  const closeMobileMenu = () => {
    if (!mobileMenu || !mobileToggle) return;
    mobileMenu.hidden = true;
    mobileToggle.setAttribute('aria-expanded', 'false');
    mobileToggle.setAttribute('aria-label', 'Open menu');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  };

  mobileToggle?.addEventListener('click', () => {
    const isOpen = mobileToggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMobileMenu() : openMobileMenu();
  });

  // Release the scroll lock if the viewport grows past the desktop
  // breakpoint while the mobile panel is open (it's hidden by CSS there,
  // but our JS-driven state would otherwise leave scroll locked).
  window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
    if (event.matches) closeMobileMenu();
  });

  // Practice-areas disclosure: close on outside click / Escape, matching the
  // "not hover-only, keyboard accessible" requirement without extra JS to
  // open it — <details>/<summary> already handles that natively.
  const detailsEls = document.querySelectorAll('header details');

  document.addEventListener('click', (event) => {
    detailsEls.forEach((d) => {
      if (d.open && !d.contains(event.target)) d.removeAttribute('open');
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    let closedSomething = false;
    detailsEls.forEach((d) => {
      if (d.open) {
        d.removeAttribute('open');
        d.querySelector('summary')?.focus();
        closedSomething = true;
      }
    });
    if (!closedSomething && mobileToggle?.getAttribute('aria-expanded') === 'true') {
      closeMobileMenu();
      mobileToggle.focus();
    }
  });
</script>
