---
/** Infinite horizontal marquee of the practice areas — the "moving bar" from
    trautfirm.com / themvp.com. The list is rendered twice back-to-back and the
    track is translated by exactly one copy's width, so the loop is seamless.
    Pauses on hover; freezes entirely under prefers-reduced-motion.

    Props:
      theme    — 'navy' (default), 'cream', or 'paper' band background
      duration — seconds for one full loop (default 40; lower = faster)
      size     — 'md' (default) or 'lg' word size */
import { practiceAreas } from '../data/practiceAreas';

interface Props {
  theme?: 'navy' | 'cream' | 'paper';
  duration?: number;
  size?: 'md' | 'lg';
}
const { theme = 'navy', duration = 40, size = 'md' } = Astro.props;

const bg =
  theme === 'navy' ? 'bg-navy' : theme === 'cream' ? 'bg-cream' : 'bg-paper';
const border = theme === 'navy' ? 'border-white/10' : 'border-line';
const word = theme === 'navy' ? 'text-paper/90' : 'text-navy';
const wordSize =
  size === 'lg'
    ? 'text-[clamp(26px,2.4vw,36px)]'
    : 'text-[clamp(19px,1.6vw,25px)]';

const items = practiceAreas.map((a) => a.name);
---

<div class:list={['marquee border-y', bg, border]} style={`--marquee-duration:${duration}s`}>
  <div class="marquee-track py-4 md:py-5">
    {/* two identical copies → seamless -50% loop */}
    {
      [0, 1].map(() => (
        <div class="marquee-copy" aria-hidden="true">
          {items.map((name) => (
            <span class="marquee-item">
              <span class="marquee-dot"></span>
              <span class:list={[wordSize, 'font-medium tracking-[0.01em]', word]}>{name}</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
  <span class="sr-only">Practice areas: {items.join(', ')}.</span>
</div>
