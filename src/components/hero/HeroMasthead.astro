---
/** Hero E — "Masthead".
    No image above the headline at all: the fix is to stop leaving room for one.
    The name of the firm's work sits flush under the nav, a hairline rule closes
    it, and a full-bleed landscape band carries the photography underneath. */
import HeroMedia from './HeroMedia.astro';
import { hero } from '../../data/hero';

interface Props {
  video?: string;
}
const { video } = Astro.props;
---

<section class="starfield overflow-hidden text-paper">
  <div class="shell pt-7 md:pt-9">
    <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-3" data-reveal>
      <p class="text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight">{hero.eyebrow}</p>
      <p class="text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.22em] text-mist">Free consultation &middot; {hero.phone}</p>
    </div>

    <h1 class="mt-5 font-serif text-[clamp(38px,6.6vw,132px)] font-medium leading-[0.98] tracking-[-0.005em]" data-reveal="left" style="--reveal-delay:80ms">
      {hero.lead}<br />
      <span class="text-gold">{hero.accent}</span> {hero.tail}
    </h1>

    <div class="mt-8 grid grid-cols-1 items-end gap-8 border-t border-[rgba(250,248,243,0.18)] pt-7 md:grid-cols-[1fr_auto] md:gap-14">
      <p class="max-w-[62ch] text-[clamp(16px,1.05vw,20px)] font-light leading-[1.75] text-mist">{hero.sub}</p>
      <div class="flex flex-col gap-4 sm:flex-row">
        <a href={hero.phoneHref} class="btn-brass lift inline-block rounded-[8px] bg-brass px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em]">Call {hero.phone}</a>
        <a href="#contact" class="lift inline-block rounded-[8px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] text-paper">Free consultation</a>
      </div>
    </div>
  </div>

  <!-- Full-bleed band: the photography reads as a horizon line under the copy. -->
  <div class="relative mt-10 md:mt-12" data-reveal="zoom">
    <HeroMedia
      src="/team.jpg"
      video={video}
      alt="The Kagasoff Law Firm team"
      position="50% 18%"
      class="aspect-[16/7] max-h-[min(48vh,460px)] md:aspect-[24/7]"
    />
    <div class="pointer-events-none absolute inset-x-0 top-0 h-1/3 bg-gradient-to-b from-[rgba(22,36,61,0.7)] to-transparent"></div>
  </div>
</section>
