---
/** Hero A — "Split" (the original layout, tightened).
    Copy left, portrait panel right. The dead band above the headline came from
    a 80px top pad plus vertical centring against a 760px-tall photo; both are
    pulled in here so the headline starts near the nav. */
import TestimonialCarousel from '../TestimonialCarousel.astro';
import HeroMedia from './HeroMedia.astro';
import { hero } from '../../data/hero';

interface Props {
  /** Set to a file in /public to run the panel as video instead of a still. */
  video?: string;
}
const { video } = Astro.props;
---

<section class="starfield overflow-hidden text-paper">
  <div class="grid shell grid-cols-1 items-center gap-12 pb-16 pt-8 md:grid-cols-[1.1fr_0.9fr] md:gap-16 md:pb-20 md:pt-10 xl:gap-24">
    <!-- Left: copy -->
    <div data-reveal="left">
      <p class="mb-5 text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight">{hero.eyebrow}</p>
      <h1 class="font-serif text-[clamp(40px,5.4vw,104px)] font-medium leading-[1.04] tracking-[0.005em]">
        {hero.lead}<br />
        <span class="text-gold">{hero.accent}</span><br />
        {hero.tail}
      </h1>
      <p class="mt-7 max-w-[52ch] text-[clamp(16px,1.1vw,20px)] font-light leading-[1.75] text-mist">{hero.sub}</p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <a href={hero.phoneHref} class="btn-brass lift inline-block rounded-[8px] bg-brass px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em]">Call {hero.phone}</a>
        <a href="#contact" class="lift inline-block rounded-[8px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] text-paper">Free consultation</a>
      </div>
      <div class="mt-10">
        <TestimonialCarousel />
      </div>
    </div>

    <!-- Right: staff panel -->
    <div class="relative mx-auto w-full max-w-[560px] md:mx-0 md:max-w-none md:justify-self-stretch" data-reveal="right" style="--reveal-delay:140ms">
      <div aria-hidden="true" class="pointer-events-none absolute -inset-3 rounded-[14px] border border-[rgba(201,190,159,0.4)] md:-inset-4"></div>
      <HeroMedia
        src="/team.jpg"
        video={video}
        alt="The Kagasoff Law Firm team"
        position="50% 35%"
        class="aspect-[4/5] max-h-[min(64vh,620px)] rounded-[14px] shadow-[0_40px_80px_-40px_rgba(0,0,0,0.7)]"
      />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 rounded-b-[14px] bg-gradient-to-t from-[rgba(16,27,48,0.85)] to-transparent"></div>
      <div class="absolute bottom-5 left-5 right-5">
        <div class="inline-flex items-center gap-2 rounded-full bg-[rgba(16,27,48,0.72)] px-4 py-2 text-[12px] tracking-[0.04em] text-paper backdrop-blur">
          <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
          A team that fights for you
        </div>
      </div>
    </div>
  </div>
</section>

