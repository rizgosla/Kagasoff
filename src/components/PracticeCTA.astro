---
/** Sand call-to-action band used at the foot of content pages: a short,
    plainspoken prompt plus the call / message actions.

    Pass `n` to render the signature ruled-margin index (§ NN) above the
    heading — used on the practice template, where it takes its place among
    the page's numbered sections. Omit `n` for a page that isn't using the
    index (e.g. a page with its own numbering), and a plain eyebrow renders
    instead so existing callers keep working unchanged. */
import SectionIndex from './SectionIndex.astro';

interface Props {
  heading?: string;
  sub?: string;
  eyebrow?: string;
  n?: number;
}
const {
  heading = 'Tell us what happened.',
  sub = 'Consultations are free and confidential.',
  eyebrow = 'Free initial consultation',
  n,
} = Astro.props;
---

<section class="relative overflow-hidden border-t border-line bg-sand">
  <div class="mx-auto max-w-page px-lg py-2xl md:px-2xl md:py-3xl">
    {
      n ? (
        <SectionIndex n={n} label={eyebrow} />
      ) : (
        <p class="mb-xs text-eyebrow font-sans font-semibold uppercase text-clay" data-reveal>
          {eyebrow}
        </p>
      )
    }

    <div class="flex flex-col items-start gap-xl sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
      <!-- Left: text -->
      <div data-reveal>
        <h2 class="text-h2 font-serif font-medium leading-tight text-ink">{heading}</h2>
        <p class="mt-xs max-w-measure text-body font-light text-stone">{sub}</p>
      </div>

      <!-- Right: CTAs -->
      <div class="flex w-full flex-col items-stretch gap-md sm:w-auto sm:flex-row sm:flex-wrap sm:items-center" data-reveal style="--reveal-delay:100ms">
        <!-- Phone — primary -->
        <a
          href="tel:+16572184947"
          class="btn-clay lift inline-flex items-center justify-center rounded-md bg-clay px-lg py-sm text-center text-body font-semibold tracking-wide"
        >Call (657) 218-4947</a>

        <!-- Message — secondary -->
        <a
          href="/contact/"
          class="lift inline-flex items-center justify-center rounded-md border border-ink px-lg py-sm text-center text-body font-medium tracking-wide text-ink transition-colors hover:bg-ink hover:text-paper"
        >
          Send a message
        </a>
      </div>
    </div>
  </div>
</section>
