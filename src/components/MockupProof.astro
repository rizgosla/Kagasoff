---
/** Shared strip shown beneath each mockup hero so the client can see the
    reveal-on-scroll animation in a realistic context (staggered fade-up). */
const stats = [
  { n: '15+', l: 'Years of courtroom experience' },
  { n: '5.0', l: 'Average Google rating' },
  { n: '7', l: 'Practice areas, one attorney-led standard' },
];
const values = [
  {
    t: 'Attorney-led, always',
    b: 'Every matter is handled directly by an attorney who knows your name and your goals — never handed off.',
  },
  {
    t: 'Prepared as if for trial',
    b: 'We build each case as though it will be tried, because that preparation is what earns the strongest outcomes.',
  },
  {
    t: 'Both sides of the courtroom',
    b: 'A rare dual perspective — clerking for both the DA and Public Defender — informs every defense strategy.',
  },
];
---

<section class="mx-auto max-w-[1180px] px-5 py-16 md:px-10 md:py-[96px]">
  <div class="mb-14 grid grid-cols-3 gap-4 md:gap-10">
    {
      stats.map((s, i) => (
        <div class="text-center" data-reveal style={`--reveal-delay:${i * 110}ms`}>
          <div class="font-serif text-[38px] font-medium leading-none text-brass md:text-[56px]">{s.n}</div>
          <div class="mx-auto mt-3 max-w-[190px] text-[12px] uppercase tracking-[0.14em] text-ink md:text-[13px]">{s.l}</div>
        </div>
      ))
    }
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
    {
      values.map((v, i) => (
        <div
          class="rounded-lg border border-line bg-paper p-7 md:p-8"
          data-reveal
          style={`--reveal-delay:${i * 130}ms`}
        >
          <div class="mb-3 h-0.5 w-9 bg-brass"></div>
          <h3 class="font-serif text-[23px] font-medium leading-[1.15] text-navy md:text-[26px]">{v.t}</h3>
          <p class="mt-3 text-[14.5px] font-light leading-[1.7] text-ink">{v.b}</p>
        </div>
      ))
    }
  </div>
</section>
