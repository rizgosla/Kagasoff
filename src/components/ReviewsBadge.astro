---
/** Overlapping staff avatars + a 5.0 Google-review rating — the "social proof"
    lockup from themvp.com. The avatars are tight circular crops pulled from the
    single staff photo (public/team.jpg) via background-position, so no separate
    headshot files are needed.

    Props:
      dark   — true on navy grounds (default), false on light grounds; only
               changes the avatar ring + text colors.
      rating — the star number (default "5.0")
      count  — review count label (default "291")
      people — which staff crops to show, left→right positions 1–5
               (default [2, 3, 4]) */
interface Props {
  dark?: boolean;
  rating?: string;
  count?: string;
  people?: number[];
  class?: string;
}
const {
  dark = true,
  rating = '5.0',
  count = '291',
  people = [2, 3, 4],
  class: cls = '',
} = Astro.props;

const ring = dark ? '#16243d' : '#faf8f3';
const nameColor = dark ? 'text-paper' : 'text-navy';
const subColor = dark ? 'text-mist' : 'text-ink';
---

<div class:list={['flex items-center gap-3.5', cls]}>
  <div class="avstack" style={`--av-ring:${ring}`}>
    {
      people.map((p) => (
        <span class={`av av-p${p}`} role="img" aria-label="Kagasoff Law Firm staff member" />
      ))
    }
  </div>

  <div class="leading-tight">
    <div class="flex items-center gap-2">
      <span class={`font-serif text-[26px] font-semibold leading-none ${nameColor}`}>{rating}</span>
      <span class="stars" aria-hidden="true">
        {
          [0, 1, 2, 3, 4].map(() => (
            <svg viewBox="0 0 20 20">
              <path d="M10 1.5l2.472 5.008 5.528.803-4 3.898.944 5.506L10 14.115l-4.944 2.6.944-5.506-4-3.898 5.528-.803L10 1.5z" />
            </svg>
          ))
        }
      </span>
    </div>
    <div class={`mt-1 text-[13px] tracking-[0.01em] ${subColor}`}>
      {count} Google Reviews
    </div>
  </div>
</div>
