                        <div class="ps-rev-line" style="width:73%"></div>
                        <div class="ps-rev-h sub" style="width:44%"></div>
                        <div class="ps-rev-line" style="width:96%"></div>
                        <div class="ps-rev-line" style="width:99%"></div>
                        <div class="ps-rev-line" style="width:90%"></div>
                        <div class="ps-rev-line" style="width:97%"></div>
                        <div class="ps-rev-line" style="width:64%"></div>
                      </div>
                    </div>
                    <div class="ps-rev-comments">
                      <div class="ps-rev-comment">
                        <div class="ps-rev-avatar">AK</div>
                        <div class="ps-rev-bubble">
                          <div class="ps-rev-meta"><span class="ps-rev-name">A. Kagasoff</span><span class="ps-rev-time">2d</span></div>
                          <div class="ps-rev-text">Records requested ✓</div>
                        </div>
                      </div>
                      <div class="ps-rev-comment offset">
                        <div class="ps-rev-avatar alt">P</div>
                        <div class="ps-rev-bubble">
                          <div class="ps-rev-meta"><span class="ps-rev-name">Paralegal</span><span class="ps-rev-time">4h</span></div>
                          <div class="ps-rev-text">Motion drafted ✓</div>
                        </div>
                      </div>
                      <div class="ps-rev-comment">
                        <div class="ps-rev-avatar">AK</div>
                        <div class="ps-rev-bubble">
                          <div class="ps-rev-meta"><span class="ps-rev-name">A. Kagasoff</span><span class="ps-rev-time">now</span></div>
                          <div class="ps-rev-text">Ready for hearing.</div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>

        <li class="process-card">
          <a class="pc-head" href="#contact">
            <span class="pc-glyph" aria-hidden="true">{glyphs[2]}</span>
            <span class="pc-step">Step 03<span class="pc-cue" aria-hidden="true">→</span></span>
            <h3 class="pc-title" set:html={process[2].title} />
            <span class="pc-hint" aria-hidden="true">
              <span class="pc-hint-open">Tap to learn more</span>
              <span class="pc-hint-close">Tap to close</span>
            </span>
          </a>
          <div class="pc-window">
            <div class="pc-reveal">
              <p class="pc-body" set:html={process[2].body} />
              <p class="pc-more">{mores[2]}</p>
              <span class="pc-meta">{metas[2]}</span>
              <a class="pc-link-out" href="#contact">Start with a free consultation →</a>
            </div>
            <div class="pc-visual" aria-hidden="true">
              <div class="pc-stage">
                {/* Built entirely from the two vocabularies already on this
                    page — the bar-top from the milestone log and the comment
                    bubble from the case file — so there is nothing new to
                    maintain and the four graphics read as one family. */}
                <div class="ps-visual-frame ps-frame-neg">
                  <div class="ps-neg">
                    <div class="ps-launch-bar-top">
                      <span class="ps-neg-dot"></span>
                      <span class="ps-launch-domain">Smith v. Meridian — <strong>settlement conf.</strong></span>
                      <span class="ps-neg-pill">IN SESSION</span>
                    </div>
                    <div class="ps-neg-thread">
                      <div class="ps-rev-comment">
                        <div class="ps-rev-avatar muted">OC</div>
                        <div class="ps-rev-bubble">
                          <div class="ps-rev-meta"><span class="ps-rev-name">Opposing counsel</span><span class="ps-rev-time">10:12 AM</span></div>
                          <div class="ps-rev-text">Opening offer — $50,000</div>
                        </div>
                      </div>
                      <div class="ps-rev-comment offset">
                        <div class="ps-rev-avatar">AK</div>
                        <div class="ps-rev-bubble">
                          <div class="ps-rev-meta"><span class="ps-rev-name">A. Kagasoff</span><span class="ps-rev-time">10:40 AM</span></div>
                          <div class="ps-rev-text">Counter — full damages + costs</div>
                        </div>
                      </div>
                      <div class="ps-rev-comment">
                        <div class="ps-rev-avatar muted">OC</div>
                        <div class="ps-rev-bubble">
                          <div class="ps-rev-meta"><span class="ps-rev-name">Opposing counsel</span><span class="ps-rev-time">11:05 AM</span></div>
                          <div class="ps-rev-text">Revised offer</div>
                        </div>
                      </div>
