                      <div class="ps-launch-row done"><span class="ps-launch-check">✓</span><span class="ps-launch-step">Discovery complete</span><span class="ps-launch-time">Mar</span></div>
                      <div class="ps-launch-row done"><span class="ps-launch-check">✓</span><span class="ps-launch-step">Motions heard</span><span class="ps-launch-time">Apr</span></div>
                      <div class="ps-launch-row done"><span class="ps-launch-check">✓</span><span class="ps-launch-step">Mediation completed</span><span class="ps-launch-time">Jun</span></div>
                      <div class="ps-launch-row done"><span class="ps-launch-check">✓</span><span class="ps-launch-step">Settlement negotiated</span><span class="ps-launch-time">Aug</span></div>
                      <div class="ps-launch-row active"><span class="ps-launch-check pulse"></span><span class="ps-launch-step">Trial ready — if needed</span><span class="ps-launch-time">Held</span></div>
                    </div>
