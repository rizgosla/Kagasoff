---
/** "With You Step by Step" — four cards in one row that trade space.
 *
 * Ported from the fwd-website process section (src/pages/index.astro), which
 * is where every load-bearing number below comes from. The comments that
 * explain those numbers are carried across with them: most of them are the
 * record of a specific failure, not a taste call.
 *
 * At rest each card IS its step's mockup: numeral, step label, title, then the
 * graphic filling everything below them. Hover or focus brings the words —
 * summary, detail and caption — in from the left on a navy panel. The graphic
 * is the card's identity; the copy is what you get for asking.
 *
 * Each card's head is a real link, so the reveal is reachable with Tab
 * (:focus-within, not :hover alone). The copy is *clipped* by the window's
 * overflow, never hidden — no display:none, no visibility:hidden — so a
 * screen reader reads all four cards in full whatever the visual state.
 * Below 1200px, and under reduced motion at any width, the panel is a
 * disclosure that opens on tap.
 */
import { process } from '../data/practiceAreas';

/** Caption line under each card's copy. Authored here rather than in
    practiceAreas because it belongs to this composition, not to the data. */
const metas = [
  '— Free & confidential',
  '— Prepared as if for trial',
  '— Leverage at the table',
  '— 17+ years of results',
];

/** Second paragraph of each reveal — the detail behind the one-line body.
 *
 * Length is a constraint, not a preference: in the four-up regime the panel
 * is ~190px wide inside a card of a definite height, and .pc-window clips
 * whatever overruns it. These are written to the measure that fits at 1200,
 * which is the tightest width the regime covers. Lengthening one truncates
 * its own last line with no warning. */
const mores = [
  'No fee to talk. If we are not the right fit, we will say so on the call.',
  'Records, reports and medical evidence, gathered early.',
  'Most matters resolve without a courtroom, because we are ready for one.',
  'Straight answers on what a resolution is really worth.',
];

const glyphs = ['i.', 'ii.', 'iii.', 'iv.'];
---

<section class="bg-cream process-section">
  <div class="shell py-14 md:py-[88px]">
    <div class="mb-11 max-w-[56ch] md:mb-14" data-reveal>
      <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">With You Step by Step</p>
      <h2 class="font-serif text-[clamp(26px,2.6vw,40px)] font-medium leading-[1.2] text-navy">
        What working with us looks like.
      </h2>
      <p class="mt-[18px] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-ink">
        A clear, four-step path from your first call to resolution — we stay beside you at every
        stage, with the same disciplined approach across every practice area.
      </p>
    </div>

    {/* Kagasoff's .shell runs to 2300px; fwd's container did not. Past ~1680px
        the four-up row stops reading as a spec sheet and starts reading as four
        billboards, so the grid gets its own ceiling inside the shell.

        No data-reveal on the grid itself: the reveal utility sets a transition
        and a will-change on the element it marks, and both of those smear the
        flex-grow animation the cards run. The head above and the button below
        carry the reveal instead. */}
    <div class="process-grid-wrap">
      <ol class="process-grid">
        <li class="process-card">
          <a class="pc-head" href="#contact">
            <span class="pc-glyph" aria-hidden="true">{glyphs[0]}</span>
            <span class="pc-step">Step 01<span class="pc-cue" aria-hidden="true">→</span></span>
            <h3 class="pc-title" set:html={process[0].title} />
            <span class="pc-hint" aria-hidden="true">
              <span class="pc-hint-open">Tap to learn more</span>
              <span class="pc-hint-close">Tap to close</span>
            </span>
          </a>
          <div class="pc-window">
            <div class="pc-reveal">
              <p class="pc-body" set:html={process[0].body} />
              <p class="pc-more">{mores[0]}</p>
              <span class="pc-meta">{metas[0]}</span>
              <a class="pc-link-out" href="#contact">Start with a free consultation →</a>
            </div>
            <div class="pc-visual" aria-hidden="true">
              <div class="pc-stage">
                <div class="ps-visual-frame ps-frame-cal">
                  <div class="ps-cal">
                    <div class="ps-cal-head">
                      <div class="ps-cal-head-l">
                        <span class="ps-cal-eyebrow">Pick a time to talk</span>
                        <h4 class="ps-cal-month">August 2026</h4>
                      </div>
                      <span class="ps-cal-pill">FREE · CONSULT</span>
                    </div>
                    <div class="ps-cal-dow"><span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span></div>
                    {/* The whole month, not a five-week window. Dropping a week
                        is what the landscape stage forced in fwd, and it is the
                        thing that made the calendar stop reading as a calendar
                        — so August 2026 gets the six rows it actually needs
                        (Sun Jul 26 through Sat Sep 5), with the 30th and 31st
                        on the last one rather than cut off the bottom. */}
                    <div class="ps-cal-grid">
                      <span class="off">26</span><span class="off">27</span><span class="off">28</span><span class="off">29</span><span class="off">30</span><span class="off">31</span><span>1</span>
                      <span>2</span><span class="avail">3</span><span class="avail">4</span><span>5</span><span class="avail">6</span><span class="avail">7</span><span>8</span>
                      <span>9</span><span class="avail">10</span><span>11</span><span class="avail">12</span><span class="avail picked">13</span><span class="avail">14</span><span>15</span>
                      <span>16</span><span>17</span><span class="avail">18</span><span class="avail">19</span><span class="avail">20</span><span>21</span><span>22</span>
                      <span>23</span><span class="avail">24</span><span class="avail">25</span><span>26</span><span class="avail">27</span><span class="avail">28</span><span>29</span>
                      <span>30</span><span class="avail">31</span><span class="off">1</span><span class="off">2</span><span class="off">3</span><span class="off">4</span><span class="off">5</span>
                    </div>
                    <div class="ps-cal-foot">
                      <div class="ps-cal-slot">
                        <span class="ps-cal-slot-dot"></span>
                        <div class="ps-cal-slot-meta">
                          <span class="ps-cal-slot-day">Thursday, Aug 13</span>
                          <span class="ps-cal-slot-time">2:00 PM · (657) 218-4947</span>
                        </div>
                        <span class="ps-cal-slot-cta">Confirmed →</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </li>

        <li class="process-card">
          <a class="pc-head" href="#contact">
            <span class="pc-glyph" aria-hidden="true">{glyphs[1]}</span>
            <span class="pc-step">Step 02<span class="pc-cue" aria-hidden="true">→</span></span>
            <h3 class="pc-title" set:html={process[1].title} />
            <span class="pc-hint" aria-hidden="true">
              <span class="pc-hint-open">Tap to learn more</span>
              <span class="pc-hint-close">Tap to close</span>
            </span>
          </a>
          <div class="pc-window">
            <div class="pc-reveal">
              <p class="pc-body" set:html={process[1].body} />
              <p class="pc-more">{mores[1]}</p>
              <span class="pc-meta">{metas[1]}</span>
              <a class="pc-link-out" href="#contact">Start with a free consultation →</a>
            </div>
            <div class="pc-visual" aria-hidden="true">
              <div class="pc-stage">
                <div class="ps-visual-frame ps-frame-rev">
                  <div class="ps-rev">
                    <div class="ps-rev-doc">
                      <div class="ps-rev-doc-head">
                        <span class="ps-rev-doc-tab">Smith matter</span>
                        <span class="ps-rev-doc-saved">Updated · 2m</span>
                      </div>
                      <div class="ps-rev-doc-body">
                        <div class="ps-rev-eye"></div>
                        <div class="ps-rev-h"></div>
                        <div class="ps-rev-line" style="width:98%"></div>
                        <div class="ps-rev-line edit" style="width:92%"><span class="ps-rev-caret"></span></div>
                        <div class="ps-rev-line struck" style="width:82%"></div>
