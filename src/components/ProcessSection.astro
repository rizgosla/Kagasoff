---
/** "With You Step by Step" — four popout cards, one per step.
 *
 * Each card is a fixed-size graphic over its own words: a mockup of what
 * that stage of a matter actually looks like, then the step kicker, the
 * title, the one-line summary, and a click disclosure holding the detail.
 *
 * There is no hover state anywhere in here. Nothing about a card depends
 * on a pointer being over it, the text is never hidden behind an
 * interaction, and the only thing a click changes is the disclosure the
 * button names in aria-controls.
 *
 * The four graphics are drawn at a fixed 470 x 360 and *scaled* to
 * whatever column they land in (see the fitter script at the bottom),
 * rather than reflowed into it: reflowing keeps the 10-12px mono at full
 * size inside a quarter-width box and tears the compositions apart. So
 * every length inside a composition is a plain px — a vw or a cq unit
 * inside a box that is scaled rather than resized re-proportions the
 * artwork by browser window while the box itself never changes.
 *
 * All four are aria-hidden decorative artwork. Every real number they
 * quote (17+ / 5.0 / 291) is also set at body size elsewhere on the page.
 */
import { process } from '../data/practiceAreas';

/** Caption line closing each disclosure. Authored here rather than in
    practiceAreas because it belongs to this composition, not to the data. */
const metas = [
  '— Free & confidential',
  '— Prepared as if for trial',
  '— Leverage at the table',
  '— 17+ years of results',
];

/** The detail behind each one-line body, revealed by the card's disclosure. */
const mores = [
  'No fee to talk. If we are not the right fit, we will say so on the call.',
  'Records, reports and medical evidence, gathered early.',
  'Most matters resolve without a courtroom, because we are ready for one.',
  'Straight answers on what a resolution is really worth.',
];

const steps = ['Step 01', 'Step 02', 'Step 03', 'Step 04'];
---

<section class="bg-cream process-section">
  <div class="shell py-14 md:py-[88px]">
    <div class="mb-11 max-w-[56ch] md:mb-14" data-reveal>
      <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">With You Step by Step</p>
      <h2 class="font-serif text-[clamp(26px,2.6vw,40px)] font-medium leading-[1.2] text-navy">
        What working with us looks like.
      </h2>
      <p class="mt-[18px] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-ink">
        A clear, four-step path from your first call to resolution — we stay beside you at every
        stage, with the same disciplined approach across every practice area.
      </p>
    </div>

    {/* Kagasoff's .shell runs to 2300px. Past ~1680px a four-up row of
        these stops reading as a set of steps and starts reading as four
        billboards, so the grid keeps its own ceiling inside the shell. */}
    <div class="process-grid-wrap">
      <ol class="process-list grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
        <li class="popout process-card p-5 md:p-6" data-reveal>
          <div class="pc-visual" aria-hidden="true">
            <div class="pc-stage">
              {/* Step 01 — the free consultation, as a call in progress:
                  who is on the line, and the ground being covered. */}
              <div class="ps-visual-frame">
                <div class="ps-call">
                  <div class="ps-call-bar">
                    <span class="ps-call-disc">K</span>
                    <span class="ps-call-id">
                      <span class="ps-call-name">Kagasoff Law Firm</span>
                      <span class="ps-call-sub">FREE CONSULTATION · 00:12</span>
                    </span>
                    <span class="ps-call-live"></span>
                  </div>
                  <ul class="ps-call-list">
                    <li class="ps-call-row done">
                      <span class="ps-call-tick">✓</span>
                      <span class="ps-call-label">What happened</span>
                    </li>
                    <li class="ps-call-row done">
                      <span class="ps-call-tick">✓</span>
                      <span class="ps-call-label">Timeline &amp; documents</span>
                    </li>
                    <li class="ps-call-row now">
                      <span class="ps-call-tick"></span>
                      <span class="ps-call-label">Your options — explained</span>
                    </li>
                  </ul>
                  <div class="ps-call-chips">
                    <span class="ps-chip">No obligation</span>
                    <span class="ps-chip">Free &amp; confidential</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="pc-step">{steps[0]}</p>
          <h3 class="pc-title" set:html={process[0].title} />
          <p class="pc-body" set:html={process[0].body} />
          <button type="button" class="pc-toggle" aria-expanded="false" aria-controls="pc-more-1" aria-label={`More about ${process[0].title}`}>
            <span aria-hidden="true">More</span>
            <svg class="pc-chev" viewBox="0 0 12 8" width="11" height="7" fill="none" aria-hidden="true">
              <path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="pc-more-1" class="pc-morewrap">
            <div class="pc-morein">
              <p class="pc-more">{mores[0]}</p>
              <span class="pc-meta">{metas[0]}</span>
            </div>
          </div>
        </li>

        <li class="popout process-card p-5 md:p-6" data-reveal style="--reveal-delay:100ms">
          <div class="pc-visual" aria-hidden="true">
            <div class="pc-stage">
              {/* Step 02 — the evidence board: what has been gathered, what
                  is still out, and how far the case theory has come. */}
              <div class="ps-visual-frame">
                <div class="ps-board">
                  <div class="ps-board-grid">
                    <div class="ps-ev">
                      <span class="ps-ev-label">Police report</span>
                      <span class="ps-ev-chip in">Received ✓</span>
                    </div>
                    <div class="ps-ev">
                      <span class="ps-ev-label">Medical records</span>
                      <span class="ps-ev-chip out"><i class="ps-ev-dot"></i>Requested</span>
                    </div>
                    <div class="ps-ev">
                      <span class="ps-ev-label">Witness statements</span>
                      <span class="ps-ev-chip in">Received ✓</span>
                    </div>
                    <div class="ps-ev">
                      <span class="ps-ev-label">Scene photos</span>
                      <span class="ps-ev-chip in">Received ✓</span>
                    </div>
                  </div>
                  <div class="ps-rail">
                    <span class="ps-rail-label">Case theory</span>
                    <span class="ps-rail-track"><span class="ps-rail-fill"></span></span>
                    <span class="ps-rail-caption">Prepared as if for trial.</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="pc-step">{steps[1]}</p>
          <h3 class="pc-title" set:html={process[1].title} />
          <p class="pc-body" set:html={process[1].body} />
          <button type="button" class="pc-toggle" aria-expanded="false" aria-controls="pc-more-2" aria-label={`More about ${process[1].title}`}>
            <span aria-hidden="true">More</span>
            <svg class="pc-chev" viewBox="0 0 12 8" width="11" height="7" fill="none" aria-hidden="true">
              <path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="pc-more-2" class="pc-morewrap">
            <div class="pc-morein">
              <p class="pc-more">{mores[1]}</p>
              <span class="pc-meta">{metas[1]}</span>
            </div>
          </div>
        </li>

        <li class="popout process-card p-5 md:p-6" data-reveal style="--reveal-delay:200ms">
          <div class="pc-visual" aria-hidden="true">
            <div class="pc-stage">
              {/* Step 03 — three rounds of offer and counter, drawn as two
                  bars that close on each other round by round. Decorative:
                  the widths are composition, not data. */}
              <div class="ps-visual-frame">
                <div class="ps-conv">
                  <div class="ps-conv-rounds">
                    <div class="ps-round">
                      <span class="ps-round-label">Round 1</span>
                      <div class="ps-bar-row">
                        <span class="ps-bar-label">Their offer</span>
                        <span class="ps-bar-track"><span class="ps-bar-fill them" style="width:25%"></span></span>
                      </div>
                      <div class="ps-bar-row">
                        <span class="ps-bar-label">Our position</span>
                        <span class="ps-bar-track"><span class="ps-bar-fill us" style="width:85%"></span></span>
                      </div>
                    </div>
                    <div class="ps-round">
                      <span class="ps-round-label">Round 2</span>
                      <div class="ps-bar-row">
                        <span class="ps-bar-label">Their offer</span>
                        <span class="ps-bar-track"><span class="ps-bar-fill them" style="width:45%"></span></span>
                      </div>
                      <div class="ps-bar-row">
                        <span class="ps-bar-label">Our position</span>
                        <span class="ps-bar-track"><span class="ps-bar-fill us" style="width:80%"></span></span>
                      </div>
                    </div>
                    <div class="ps-round">
                      <span class="ps-round-label">Round 3</span>
                      <div class="ps-bar-row">
                        <span class="ps-bar-label">Their offer</span>
                        <span class="ps-bar-track"><span class="ps-bar-fill them" style="width:68%"></span></span>
                      </div>
                      <div class="ps-bar-row">
                        <span class="ps-bar-label">Our position</span>
                        <span class="ps-bar-track"><span class="ps-bar-fill us" style="width:72%"></span></span>
                      </div>
                    </div>
                  </div>
                  <div class="ps-conv-strip">
                    <span class="ps-conv-check">✓</span>
                    <span class="ps-conv-title">Settlement reached</span>
                    <span class="ps-conv-note">on our terms</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="pc-step">{steps[2]}</p>
          <h3 class="pc-title" set:html={process[2].title} />
          <p class="pc-body" set:html={process[2].body} />
          <button type="button" class="pc-toggle" aria-expanded="false" aria-controls="pc-more-3" aria-label={`More about ${process[2].title}`}>
            <span aria-hidden="true">More</span>
            <svg class="pc-chev" viewBox="0 0 12 8" width="11" height="7" fill="none" aria-hidden="true">
              <path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="pc-more-3" class="pc-morewrap">
            <div class="pc-morein">
              <p class="pc-more">{mores[2]}</p>
              <span class="pc-meta">{metas[2]}</span>
            </div>
          </div>
        </li>

        <li class="popout process-card p-5 md:p-6" data-reveal style="--reveal-delay:300ms">
          <div class="pc-visual" aria-hidden="true">
            <div class="pc-stage">
              {/* Step 04 — the closing page of the matter: the word, the
                  terms that were secured, and the firm's record under a
                  hairline. */}
              <div class="ps-visual-frame">
                <div class="ps-close">
                  <div class="ps-close-banner">
                    <div class="ps-close-crest">
                      <span class="ps-arc l"></span>
                      <span class="ps-close-word">Resolved</span>
                      <span class="ps-arc r"></span>
                    </div>
                    <span class="ps-close-rule"></span>
                    <span class="ps-close-chip">Case closed</span>
                  </div>
                  <ul class="ps-close-terms">
                    <li><span class="ps-close-tick">✓</span><span>Compensation secured</span></li>
                    <li><span class="ps-close-tick">✓</span><span>Costs covered</span></li>
                    <li><span class="ps-close-tick">✓</span><span>Guidance for what&rsquo;s next</span></li>
                  </ul>
                  <div class="ps-close-foot">
                    <span><b>17+</b> Years</span><em>·</em>
                    <span><b>5.0</b> Rating</span><em>·</em>
                    <span><b>291</b> Reviews</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="pc-step">{steps[3]}</p>
          <h3 class="pc-title" set:html={process[3].title} />
          <p class="pc-body" set:html={process[3].body} />
          <button type="button" class="pc-toggle" aria-expanded="false" aria-controls="pc-more-4" aria-label={`More about ${process[3].title}`}>
            <span aria-hidden="true">More</span>
            <svg class="pc-chev" viewBox="0 0 12 8" width="11" height="7" fill="none" aria-hidden="true">
              <path d="M1 1.5 6 6.5 11 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="pc-more-4" class="pc-morewrap">
            <div class="pc-morein">
              <p class="pc-more">{mores[3]}</p>
              <span class="pc-meta">{metas[3]}</span>
            </div>
          </div>
        </li>
      </ol>
    </div>

    <div class="mt-11 md:mt-14" data-reveal>
      <a href="#contact" class="lift inline-block rounded-[8px] bg-navy px-[30px] py-4 text-center text-sm font-semibold tracking-[0.04em] text-paper">Start with a free consultation →</a>
    </div>
  </div>
</section>

<style is:global>
  /* Registered so that an engine which drops the scale declaration falls
     back to a usable 0.8 rather than losing the transform outright.
     @property cannot be scoped, so it sits in its own global block. */
  @property --pc-scale {
    syntax: "<number>";
    inherits: true;
    initial-value: 0.8;
  }
</style>

<style>
  .process-section {
    --ease-soft: cubic-bezier(0.2, 0.7, 0.2, 1);
    --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --pc-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    /* The paper the mockup frames are drawn on — a touch brighter than
       --color-paper so a frame reads as a sheet laid on the card. */
    --pc-sheet: #fffdf9;
    /* A muted colour rather than a low-alpha wash: at ~20% alpha the
       secondary text in these frames composites to about 1.5:1. */
    --pc-muted: #a39a83;
    --pc-green: #2f9e6a;
  }

  @keyframes pcPulseRing {
    0%   { box-shadow: 0 0 0 0    rgb(201 162 83 / 0.5); }
    70%  { box-shadow: 0 0 0 14px rgb(201 162 83 / 0); }
    100% { box-shadow: 0 0 0 0    rgb(201 162 83 / 0); }
  }
  @keyframes pcBlink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }

  .process-grid-wrap { max-width: 1680px; margin-inline: auto; }
  .process-list { list-style: none; margin: 0; padding: 0; }

  .process-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* ----- The words under the graphic ----- */
  .pc-step {
    margin: 18px 0 0;
    font-family: var(--pc-mono);
    font-size: clamp(11px, 0.66vw, 12.5px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-brass);
  }
  .pc-title {
    margin: 8px 0 0;
    font-family: var(--font-serif);
    /* Cormorant is a light face; 500 is what reads as a card title here
       where a variable display font would use ~350. */
    font-weight: 500;
    font-size: clamp(20px, 1.4vw, 26px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-navy);
    text-wrap: balance;
  }
  /* :global(em), because the title is injected with set:html from
     practiceAreas — Astro's scope attribute lands on elements in this
     template, never on nodes parsed out of a string. */
  .pc-title :global(em) { font-style: italic; color: var(--color-brass); }
  .pc-body {
    margin: 10px 0 0;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(14.5px, 0.88vw, 16.5px);
    line-height: 1.6;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  /* ----- The disclosure ----- */
  .pc-toggle {
    /* margin-top: auto keeps the four buttons on one line across a row
       of cards whose bodies wrap to different numbers of lines. */
    margin-top: auto;
    padding: 12px 0 0;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--pc-mono);
    font-size: clamp(10.5px, 0.62vw, 12px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brass);
    /* A quiet text button, but still a real 44px target on touch. */
    min-height: 44px;
  }
  .pc-toggle:focus-visible {
    outline: 2px solid var(--color-brass);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .pc-chev {
    display: block;
    transition: transform 0.35s var(--ease-out-expo);
  }
  .pc-toggle[aria-expanded="true"] .pc-chev { transform: rotate(180deg); }

  /* Clipped by max-height, never display:none and never hidden, so a
     screen reader reads all four cards in full whatever is open. */
  .pc-morewrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s var(--ease-out-expo);
  }
  /* A ceiling, not a height — it only has to clear the tallest of the
     four blocks, and a transition needs a length to land on. */
  .pc-morewrap.is-open { max-height: 22rem; }
  .pc-morein {
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pc-more {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(13.5px, 0.8vw, 15px);
    line-height: 1.6;
    color: var(--color-ink);
    text-wrap: pretty;
  }
  .pc-meta {
    display: block;
    font-family: var(--pc-mono);
    font-size: clamp(11px, 0.66vw, 12.5px);
    letter-spacing: 0.05em;
    color: var(--pc-muted);
  }

  /* ============================================================
     THE GRAPHICS.

     Each is drawn in a fixed 470 x 360 box and scaled to the column
     it lands in — see the fitter script. The box never changes size,
     so nothing inside one may use a viewport or container unit.
     ============================================================ */
  .pc-visual {
    --stage-w: 470px;
    --stage-h: 360px;
    position: relative;
    /* Unitless on purpose — `470px / 360px` is not a valid
       aspect-ratio — so keep these two in step with the vars above. */
    aspect-ratio: 470 / 360;
    /* Gives the box a definite size on both axes, which is what lets
       the fitter constrain the height as well as the width. */
    container-type: size;
    overflow: hidden;
    border-radius: 14px;
    /* No background: the frame carries its own sheet and shadow, and a
       second panel behind it would show at the edges. */
    background: transparent;
  }
  .pc-stage {
    /* Dividing a length by a length is not something calc() will do, so
       the ratio is measured in JS and written back here as an inline
       custom property. This value is only the pre-script fallback. */
    --pc-scale: 0.8;
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--stage-w);
    height: var(--stage-h);
    margin: calc(var(--stage-h) / -2) 0 0 calc(var(--stage-w) / -2);
    transform: scale(var(--pc-scale));
    transform-origin: center center;
  }

  .ps-visual-frame {
    position: relative;
    width: 100%;
    height: 100%;
    /* The sheet, warming into cream at the foot — the same wash on all
       four so the set reads as one family. */
    background: linear-gradient(180deg, var(--pc-sheet) 0%, var(--color-cream) 100%);
    border-radius: 14px;
    border: 1px solid var(--color-line);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .ps-visual-frame > * { flex: 1; min-height: 0; }
  /* Every composition works to the same 24px margin inside the frame. */
  .ps-call,
  .ps-board,
  .ps-conv,
  .ps-close {
    padding: 24px;
    display: flex;
    flex-direction: column;
  }
  .ps-call ul,
  .ps-close ul { list-style: none; margin: 0; padding: 0; }

  /* Shared card chassis for the small panels inside the frames. */
  .ps-call-bar,
  .ps-call-row,
  .ps-ev,
  .ps-conv-strip {
    background: var(--pc-sheet);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    box-shadow: 0 12px 28px -18px rgb(22 36 61 / 0.22);
  }

  /* ----- Step 01: the consultation call ----- */
  .ps-call { gap: 16px; }
  .ps-call-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 14px;
  }
  .ps-call-disc {
    width: 38px; height: 38px; border-radius: 50%;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--color-navy);
    color: var(--color-gold);
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 19px;
    line-height: 1;
  }
  .ps-call-id { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ps-call-name {
    font-family: var(--font-serif); font-weight: 600;
    font-size: 15px; letter-spacing: -0.01em;
    color: var(--color-navy);
  }
  .ps-call-sub {
    font-family: var(--pc-mono); font-size: 10px;
    letter-spacing: 0.11em; color: var(--pc-muted);
  }
  .ps-call-live {
    margin-left: auto; flex-shrink: 0;
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--pc-green);
    box-shadow: 0 0 0 4px rgb(47 158 106 / 0.18);
    animation: pcPulseRing 2s var(--ease-soft) infinite;
  }
  /* The checklist takes the frame's slack so the three rows spread over
     the middle of the composition rather than stacking at its top. */
  .ps-call-list {
    flex: 1;
    display: flex; flex-direction: column;
    justify-content: space-between;
    gap: 10px;
  }
  .ps-call-row {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
  }
  .ps-call-tick {
    width: 20px; height: 20px; border-radius: 50%;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; line-height: 1;
    background: var(--pc-green);
    color: var(--pc-sheet);
  }
  .ps-call-label {
    font-family: var(--font-serif); font-size: 14px;
    color: var(--color-navy);
  }
  /* The row being worked through: ringed in brass, no check yet. */
  .ps-call-row.now { border-color: rgb(201 162 83 / 0.55); }
  .ps-call-row.now .ps-call-tick {
    background: transparent;
    border: 1.5px solid var(--color-brass);
    animation: pcPulseRing 2.4s var(--ease-soft) infinite;
  }
  .ps-call-row.now .ps-call-label { color: var(--color-brass); }
  .ps-call-chips { display: flex; gap: 10px; }
  .ps-chip {
    flex: 1;
    text-align: center;
    padding: 8px 10px;
    border-radius: 999px;
    border: 1px solid rgb(201 162 83 / 0.45);
    background: rgb(227 201 147 / 0.16);
    font-family: var(--pc-mono); font-size: 10px;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--color-brass);
    white-space: nowrap;
  }

  /* ----- Step 02: the evidence board ----- */
  .ps-board { gap: 18px; }
  .ps-board-grid {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .ps-ev {
    padding: 14px;
    display: flex; flex-direction: column;
    justify-content: space-between;
    gap: 12px;
  }
  .ps-ev-label {
    font-family: var(--font-serif); font-weight: 600;
    font-size: 14px; line-height: 1.2;
    color: var(--color-navy);
  }
  .ps-ev-chip {
    align-self: flex-start;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 9px;
    border-radius: 999px;
    font-family: var(--pc-mono); font-size: 9px;
    letter-spacing: 0.12em; text-transform: uppercase;
    white-space: nowrap;
  }
  .ps-ev-chip.in {
    background: rgb(47 158 106 / 0.12);
    border: 1px solid rgb(47 158 106 / 0.35);
    color: #1f6b4a;
  }
  .ps-ev-chip.out {
    background: rgb(227 201 147 / 0.2);
    border: 1px solid rgb(201 162 83 / 0.45);
    color: var(--color-brass);
  }
  .ps-ev-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-brass);
    animation: pcBlink 1.4s steps(1) infinite;
  }
  .ps-rail { display: flex; flex-direction: column; gap: 9px; }
  .ps-rail-label {
    font-family: var(--pc-mono); font-size: 10px;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--pc-muted);
  }
  .ps-rail-track {
    height: 7px; border-radius: 999px;
    background: rgb(22 36 61 / 0.09);
    overflow: hidden;
  }
  .ps-rail-fill {
    display: block;
    width: 70%; height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-brass), var(--color-brasslight));
  }
  .ps-rail-caption {
    font-family: var(--font-serif); font-style: italic;
    font-size: 14px; color: var(--color-ink);
  }

  /* ----- Step 03: three rounds, converging ----- */
  .ps-conv { gap: 18px; }
  .ps-conv-rounds {
    flex: 1;
    display: flex; flex-direction: column;
    justify-content: space-between;
    gap: 14px;
  }
  .ps-round { display: flex; flex-direction: column; gap: 7px; }
  .ps-round-label {
    font-family: var(--pc-mono); font-size: 9.5px;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--pc-muted);
  }
  .ps-bar-row {
    display: grid;
    grid-template-columns: 82px 1fr;
    align-items: center;
    gap: 10px;
  }
  .ps-bar-label {
    font-family: var(--pc-mono); font-size: 9.5px;
    letter-spacing: 0.04em;
    color: rgb(22 36 61 / 0.6);
    text-align: right;
    white-space: nowrap;
  }
  .ps-bar-track {
    height: 10px;
    border-radius: 999px;
    background: rgb(22 36 61 / 0.07);
  }
  .ps-bar-fill {
    display: block;
    height: 100%;
    border-radius: 999px;
  }
  .ps-bar-fill.them { background: rgb(22 36 61 / 0.38); }
  .ps-bar-fill.us {
    background: linear-gradient(90deg, var(--color-brass), var(--color-brasslight));
  }
  .ps-conv-strip {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px;
    border-color: rgb(47 158 106 / 0.4);
  }
  .ps-conv-check {
    width: 22px; height: 22px; border-radius: 50%;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--pc-green); color: var(--pc-sheet);
    font-size: 12px; line-height: 1;
  }
  .ps-conv-title {
    font-family: var(--font-serif); font-weight: 600;
    font-size: 15px; color: var(--color-navy);
    letter-spacing: -0.01em;
  }
  .ps-conv-note {
    margin-left: auto;
    font-family: var(--pc-mono); font-size: 9.5px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--pc-muted);
    white-space: nowrap;
  }

  /* ----- Step 04: the matter, closed ----- */
  .ps-close { gap: 18px; }
  .ps-close-banner {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px;
  }
  .ps-close-crest { display: flex; align-items: center; gap: 14px; }
  /* Two arcs, drawn as thirds of a ring — a laurel without an SVG. */
  .ps-arc {
    width: 15px; height: 42px;
    border: 1.5px solid var(--color-brass);
    border-radius: 50%;
    opacity: 0.6;
  }
  .ps-arc.l {
    border-top-color: transparent;
    border-right-color: transparent;
    transform: rotate(-16deg);
  }
  .ps-arc.r {
    border-top-color: transparent;
    border-left-color: transparent;
    transform: rotate(16deg);
  }
  .ps-close-word {
    font-family: var(--font-serif); font-weight: 600;
    font-size: 38px; line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-navy);
  }
  /* A double rule: the element is the upper line, its ::after the lower. */
  .ps-close-rule {
    position: relative;
    width: 128px; height: 1px;
    background: rgb(156 122 60 / 0.6);
  }
  .ps-close-rule::after {
    content: "";
    position: absolute;
    left: 22px; right: 22px; top: 4px;
    height: 1px;
    background: rgb(156 122 60 / 0.3);
  }
  .ps-close-chip {
    margin-top: 2px;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid rgb(201 162 83 / 0.45);
    background: rgb(227 201 147 / 0.18);
    font-family: var(--pc-mono); font-size: 9.5px;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--color-brass);
  }
  .ps-close-terms {
    flex: 1;
    display: flex; flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .ps-close-terms li {
    display: flex; align-items: center; gap: 11px;
    font-family: var(--font-serif); font-size: 14px;
    color: var(--color-navy);
  }
  .ps-close-tick {
    width: 19px; height: 19px; border-radius: 50%;
    flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--pc-green); color: var(--pc-sheet);
    font-size: 10px; line-height: 1;
  }
  .ps-close-foot {
    display: flex; align-items: baseline; justify-content: center;
    gap: 9px;
    padding-top: 14px;
    border-top: 1px solid var(--color-line);
    font-family: var(--pc-mono); font-size: 9.5px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--pc-muted);
    white-space: nowrap;
  }
  .ps-close-foot b {
    font-family: var(--font-serif); font-weight: 600;
    font-size: 15px; letter-spacing: 0;
    color: var(--color-navy);
  }
  .ps-close-foot em { font-style: normal; color: var(--color-line); }

  /* ============================================================
     REDUCED MOTION.

     Kagasoff's global.css guards specific components (the reveal
     utility, the carousel, the team-card bio) rather than carrying a
     universal killswitch, so there is no net under the loops inside
     these frames — the pulsing call dot, the pulsing intake ring and
     the blinking "requested" dot — and the section has to stop its
     own. The disclosure's max-height and the chevron's rotation go
     with them: the state still changes, it just snaps.

     `animation`, not `animation-duration`: these loops are purely
     decorative and there is no final frame worth landing on.
     ============================================================ */
  @media (prefers-reduced-motion: reduce) {
    .process-section *,
    .process-section *::before,
    .process-section *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  // Process cards — each "More" button opens the block it names in
  // aria-controls. Independent per card; no media queries, no shared state.
  (() => {
    const toggles = document.querySelectorAll('.process-section .pc-toggle');
    toggles.forEach((btn) => {
      const wrap = document.getElementById(btn.getAttribute('aria-controls'));
      if (!wrap) return;
      btn.addEventListener('click', () => {
        const open = !wrap.classList.contains('is-open');
        wrap.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', String(open));
      });
    });
  })();
</script>

<script is:inline>
  // Process mockups — fit each fixed-size stage to the box it lands in.
  // This is a ratio of two lengths, which CSS calc() cannot compute, so it is
  // measured here and written back as --pc-scale. Without it every stage
  // renders at the stylesheet's 0.8 fallback and overflows its card.
  (() => {
    const stages = Array.from(document.querySelectorAll('.pc-stage'));
    if (!stages.length) return;
    const fit = () => {
      stages.forEach((stage) => {
        const box = stage.parentElement;
        if (!box) return;
        const w = box.clientWidth;
        if (!w) return;
        const cs = getComputedStyle(stage);
        const baseW = parseFloat(cs.width) || 470;
        const baseH = parseFloat(cs.height) || 360;
        // Fit BOTH axes: .pc-visual has a definite height (aspect-ratio), and
        // sub-pixel rounding between it and the stage means a width-only fit
        // can still clip a hairline off the top and bottom of the frame.
        const h = box.clientHeight;
        const ratio = h > 0 ? Math.min(w / baseW, h / baseH) : w / baseW;
        const s = Math.min(Math.max(ratio, 0.3), 1.6);
        stage.style.setProperty('--pc-scale', String(s));
      });
    };
    fit();
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(fit);
      stages.forEach((s) => s.parentElement && ro.observe(s.parentElement));
    } else {
      window.addEventListener('resize', fit, { passive: true });
    }
  })();
</script>
