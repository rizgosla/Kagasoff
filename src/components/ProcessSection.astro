        </li>

        <li class="process-card">
          <a class="pc-head" href="#contact">
            <span class="pc-glyph" aria-hidden="true">{glyphs[3]}</span>
            <span class="pc-step">Step 04<span class="pc-cue" aria-hidden="true">→</span></span>
            <h3 class="pc-title" set:html={process[3].title} />
            <span class="pc-hint" aria-hidden="true">
              <span class="pc-hint-open">Tap to learn more</span>
              <span class="pc-hint-close">Tap to close</span>
            </span>
          </a>
          <div class="pc-window">
            <div class="pc-reveal">
              <p class="pc-body" set:html={process[3].body} />
              <p class="pc-more">{mores[3]}</p>
