---
/** Reusable consultation intake form. Validates in the browser, then POSTs to
    /api/intake, which is what actually delivers the message (via Resend).
    Rendered multiple times on a page — every id/for pair is namespaced by
    `uid` so labels stay associated without collisions, and the shared script
    wires each instance via querySelectorAll, because Astro dedupes a
    component's client script across its instances.

    Note: no literal script tag in this comment. The compiler reads one even
    inside a comment, splits the file there, and hands esbuild the remainder
    as JavaScript — which fails the dev server's dependency scan. */
import { practiceAreas } from '../data/practiceAreas';

interface Props {
  uid: string;
  heading?: string;
}

const { uid, heading = 'Request a free consultation' } = Astro.props;

const matterOptions = [...practiceAreas.map((a) => a.name), 'Not sure / Other'];

const labelCls = 'mb-2 block text-xs uppercase tracking-[0.08em] text-ink';
---

<div class="consult popout p-6 md:p-8">
  <form class="consult-form" novalidate aria-label="Free consultation request">
    {heading && <h2 class="mb-1.5 font-serif text-[clamp(26px,2.2vw,32px)] font-medium text-navy">{heading}</h2>}
    <p class="mb-[30px] text-[14px] font-light text-ink">
      Fields marked <span class="text-brass">*</span> are required.
    </p>

    <div class="mb-5">
      <label class={labelCls} for={`${uid}-name`}>Name <span class="text-brass">*</span></label>
      <input class="fld" id={`${uid}-name`} name="name" type="text" placeholder="Your full name" />
    </div>

    <div class="mb-5">
      <label class={labelCls} for={`${uid}-phone`}>Phone <span class="text-brass">*</span></label>
      <input class="fld" id={`${uid}-phone`} name="phone" type="tel" placeholder="(657) 000-0000" />
    </div>

    <div class="mb-5">
      <label class={labelCls} for={`${uid}-email`}>Email</label>
      <input class="fld" id={`${uid}-email`} name="email" type="email" placeholder="you@email.com" />
    </div>

    <div class="mb-5">
      <label class={labelCls} for={`${uid}-area`}>Matter type</label>
      <select class="fld" id={`${uid}-area`} name="area">
        {matterOptions.map((o) => <option value={o}>{o}</option>)}
      </select>
    </div>

    <div class="mb-6">
      <label class={labelCls} for={`${uid}-message`}>How can we help? <span class="text-brass">*</span></label>
      <textarea class="fld" id={`${uid}-message`} name="message" placeholder="Briefly describe your situation. Do not include confidential details you wouldn't want sent by email."></textarea>
    </div>

    {/* Honeypot. Positioned off-screen and hidden from assistive tech, so only
        a bot ever fills it; /api/intake drops anything that arrives with it set. */}
    <div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" aria-hidden="true">
      <label for={`${uid}-company`}>Company</label>
      <input id={`${uid}-company`} name="company" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-error mb-5 hidden rounded-md border border-error-line bg-error-bg px-4 py-3 text-[13.5px] text-error" role="alert">
      Please enter your name, a phone number, and a short message.
    </div>

    <button type="submit" class="btn-brass lift w-full rounded-[8px] bg-brass py-4 text-sm font-semibold tracking-[0.04em]">Submit request</button>
    <p class="mt-5 max-w-[48ch] text-[12px] font-light leading-[1.6] text-ink/60">
      Submitting this form does not create an attorney–client relationship. Information sent
      through this form is not confidential until an engagement is established.
    </p>
  </form>

  <!-- Confirmation (hidden until submit) -->
  <div class="confirm-panel hidden rounded-[14px] bg-navy px-6 py-9 text-paper md:px-11 md:py-12">
    <div class="mb-3.5 font-serif text-[26px] md:text-[34px]">Thank you, <span class="confirm-name">there</span>.</div>
    <p class="mb-2 text-[16px] font-light leading-[1.7] text-mist">
      Your message has been received. An attorney will be in touch shortly — typically within
      one business day.
    </p>
    <p class="mb-7 text-[16px] font-light leading-[1.7] text-mist">
      If your matter is urgent, please call us directly.
    </p>
    <div class="flex flex-col gap-3.5 sm:flex-row sm:flex-wrap">
      <a href="tel:6572184947" class="btn-brass lift inline-block rounded-[8px] bg-brass px-[30px] py-4 text-center text-sm font-semibold tracking-[0.04em]">Call (657) 218-4947</a>
      <button type="button" class="reset-form lift inline-block rounded-[8px] border border-[rgba(250,248,243,0.4)] px-[30px] py-4 text-sm font-semibold tracking-[0.04em] text-paper">Send another message</button>
    </div>
  </div>
</div>

<script>
  // Validate here, then hand the message to /api/intake, which is what sends
  // it. The confirmation panel only appears once the server has accepted it —
  // a failed send has to say so rather than show a thank-you for a message
  // that never arrived.
  document.querySelectorAll('.consult').forEach((root) => {
    const form = root.querySelector('.consult-form') as HTMLFormElement | null;
    if (!form) return;
    const errorBox = root.querySelector('.form-error') as HTMLElement | null;
    const confirmPanel = root.querySelector('.confirm-panel');
    const nameOut = root.querySelector('.confirm-name');
    const resetBtn = root.querySelector('.reset-form');
    const submitBtn = form.querySelector('button[type=submit]') as HTMLButtonElement | null;
    const submitLabel = submitBtn?.textContent ?? 'Submit request';

    const showError = (msg: string) => {
      if (!errorBox) return;
      errorBox.textContent = msg;
      errorBox.classList.remove('hidden');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const field = (k: string) => (data.get(k) || '').toString().trim();
      const name = field('name');

      if (!name || !field('phone') || !field('message')) {
        showError('Please enter your name, a phone number, and a short message.');
        return;
      }

      errorBox?.classList.add('hidden');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }

      try {
        const res = await fetch('/api/intake', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name,
            phone: field('phone'),
            email: field('email'),
            area: field('area'),
            message: field('message'),
            company: field('company'),
          }),
        });
        if (!res.ok) throw new Error(`intake responded ${res.status}`);

        if (nameOut) nameOut.textContent = name.split(/\s+/)[0];
        form.style.display = 'none';
        confirmPanel?.classList.remove('hidden');
      } catch {
        showError('Sorry — that didn’t send. Please try again, or call (657) 218-4947.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitLabel;
        }
      }
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      confirmPanel?.classList.add('hidden');
      form.style.display = '';
    });
  });
</script>
