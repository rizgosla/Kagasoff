---
/** Inkdeep footer — NAP block, all 7 practice links, firm links, business
    hours (NEEDS-CLIENT), and an attorney-advertising disclaimer. */
import { practiceAreas } from '../data/practiceAreas';

const year = new Date().getFullYear();
---

<footer class="bg-inkdeep text-mist">
  <div class="mx-auto max-w-page px-lg pb-xl pt-2xl md:px-xl md:pt-3xl">
    <div class="grid grid-cols-1 gap-xl sm:grid-cols-2 md:grid-cols-[1.6fr_1fr_1fr] md:gap-2xl">
      <!-- Brand / NAP -->
      <div class="sm:col-span-2 md:col-span-1">
        <p class="font-serif text-h3 leading-tight text-paper">Kagasoff Law Firm, A.P.C.</p>

        <address class="mt-sm text-meta not-italic leading-relaxed text-mist">
          14541 Brookhurst St, Suite D4 <!-- NEEDS-CLIENT: live Wix contact page says "Suite B7"; repo says "D4" — confirm against the Google Business Profile before launch --><br />
          Westminster, CA 92683
        </address>

        <p class="mt-sm text-meta">
          <a href="tel:+16572184947" class="inline-flex min-h-11 items-center text-claylight hover:underline">(657) 218-4947</a>
        </p>
        <p class="mt-2xs text-meta">
          Fax: <a href="tel:+16579002884" class="inline-flex min-h-11 items-center text-claylight hover:underline">657-900-2884</a>
        </p>

        <!-- NEEDS-CLIENT: business hours not available in BRIEF.md or the repo. -->
        <p class="mt-sm text-meta text-mist">Hours: call to confirm</p>
      </div>

      <!-- Practice areas -->
      <div>
        <h2 class="mb-md text-eyebrow uppercase text-claylight">Practice areas</h2>
        <ul class="flex flex-col">
          {
            practiceAreas.map((p) => (
              <li>
                <a href={`/practice/${p.slug}/`} class="flex min-h-11 items-center text-meta text-mist transition-colors hover:text-paper">
                  {p.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Firm -->
      <div>
        <h2 class="mb-md text-eyebrow uppercase text-claylight">Firm</h2>
        <ul class="flex flex-col">
          <li>
            <a href="/about/" class="flex min-h-11 items-center text-meta text-mist transition-colors hover:text-paper">
              About the attorney
            </a>
          </li>
          <li>
            <a href="/contact/" class="flex min-h-11 items-center text-meta text-mist transition-colors hover:text-paper">
              Request a consultation
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="mt-xl border-t border-linedark pt-md text-meta text-mist">
      <p class="max-w-prose">
        Attorney advertising. Prior results do not guarantee a similar outcome. Nothing on this
        site is legal advice or creates an attorney-client relationship.
      </p>
      <p class="mt-xs">&copy; {year} Kagasoff Law Firm, A.P.C. All rights reserved.</p>
    </div>
  </div>
</footer>
