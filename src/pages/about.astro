---
/** About — Style A: starfield hero with review proof, vision two-column, cream
    "what you can expect" values, the navy attorney bio band, closing CTA. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import PracticeCTA from '../components/PracticeCTA.astro';
import PracticeMarquee from '../components/PracticeMarquee.astro';
import ReviewsBadge from '../components/ReviewsBadge.astro';

const values = [
  { numeral: 'I.', title: 'Attentiveness', body: 'We stay fully present and engaged — listening to your concerns and shaping legal solutions around your unique situation.' },
  { numeral: 'II.', title: 'Relentless preparation', body: 'Every case is prepared as if it will be tried. That readiness is what creates leverage at the table.' },
  { numeral: 'III.', title: 'Straight answers', body: 'We tell you where you stand in plain language, so you can make decisions with confidence.' },
];

const credentials = [
  { k: '17+ years', v: 'Of trial & advocacy experience' },
  { k: 'UCLA', v: 'B.A., 2003' },
  { k: 'Chapman', v: 'J.D., School of Law, 2007' },
];
---

<BaseLayout title="About — Kagasoff Law Firm, A.P.C.">
  <!-- HERO -->
  <section class="starfield overflow-hidden text-paper">
    <div class="shell pb-16 pt-16 md:pb-24 md:pt-24">
      <p class="mb-7 text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight" data-reveal>About the Firm</p>
      <h1 class="mb-9 max-w-[920px] font-serif text-[clamp(38px,5.8vw,74px)] font-medium leading-[1.06] tracking-[0.005em]" data-reveal style="--reveal-delay:80ms">
        A firm that stands<br /><span class="text-gold">on your side.</span>
      </h1>
      <div class="flex max-w-[70ch] items-start gap-5 md:gap-7" data-reveal style="--reveal-delay:150ms">
        <span aria-hidden="true" class="mt-4 h-px w-10 shrink-0 bg-brass md:w-14"></span>
        <p class="text-[16px] font-light leading-[1.75] text-mist md:text-[18px]">
          Giving your case the attention and time it deserves &mdash; and doing what&rsquo;s genuinely best for you.
        </p>
      </div>
      <div class="mt-11" data-reveal style="--reveal-delay:220ms">
        <ReviewsBadge count="291" people={[1, 2, 3, 4, 5]} />
      </div>
    </div>
  </section>

  <PracticeMarquee theme="navy" />

  <!-- VISION -->
  <section class="grid shell grid-cols-1 items-start gap-10 py-14 md:grid-cols-2 md:gap-16 md:py-[78px]">
    <div data-reveal="left">
      <p class="mb-[18px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">Our Vision</p>
      <p class="mb-6 font-serif text-[clamp(23px,1.75vw,34px)] leading-[1.4] text-navy">
        To provide exceptional legal counsel and representation that exceeds our clients' expectations.
      </p>
      <p class="text-[clamp(15.5px,0.95vw,19px)] font-light leading-[1.8] text-ink">
        Based in Westminster and serving clients throughout Orange County and the greater California
        region, the firm handles matters across seven practice areas — from personal injury and
        criminal defense to family law and professional licensing. What unites that range is a single
        approach: thorough preparation, plain-spoken advice, and direct access to the attorney working
        on your case.
      </p>
    </div>
    <div class="relative" data-reveal="right" style="--reveal-delay:120ms">
      <div aria-hidden="true" class="pointer-events-none absolute rounded-[6px] border border-[rgba(156,122,60,0.5)]" style="inset:-16px 16px 16px -16px"></div>
      <Photo src="/team.jpg" alt="The Kagasoff Law Firm team" position="50% 30%" class="relative min-h-[clamp(280px,34vw,560px)] rounded-[6px]" />
    </div>
  </section>

  <!-- VALUES -->
  <section class="bg-cream">
    <div class="shell py-14 md:py-[74px]">
      <p class="mb-4 text-center text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass" data-reveal>Our Commitment</p>
      <h2 class="mb-10 text-center font-serif text-[30px] font-medium text-navy md:mb-[52px] md:text-[40px]" data-reveal style="--reveal-delay:80ms">What you can expect</h2>
      <div class="grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-12">
        {
          values.map((v, i) => (
            <div class="border-t border-line pt-[22px]" data-reveal style={`--reveal-delay:${i * 120}ms`}>
              <div class="mb-[14px] font-serif text-[32px] text-brass">{v.numeral}</div>
              <h3 class="mb-3 font-serif text-[23px] font-semibold text-navy">{v.title}</h3>
              <p class="text-[clamp(14.5px,0.9vw,17.5px)] font-light leading-[1.7] text-ink">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ATTORNEY -->
  <section class="bg-navydark text-paper">
    <div class="grid shell grid-cols-1 items-center gap-10 py-14 md:grid-cols-[0.9fr_1.1fr] md:gap-[clamp(56px,5vw,110px)] md:py-[100px]">
      <div class="relative" data-reveal="left">
        <div aria-hidden="true" class="pointer-events-none absolute rounded-[6px] border border-[rgba(201,190,159,0.45)]" style="inset:20px -20px -20px 20px"></div>
        <Photo src="/ashley-portrait.jpg" alt="Ashley Kagasoff" dark position="50% 25%" class="relative min-h-[clamp(320px,38vw,640px)] rounded-[6px]" />
      </div>

      <div data-reveal="right" style="--reveal-delay:120ms">
        <p class="mb-[22px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight">The Attorney</p>
        <h2 class="mb-1.5 font-serif text-[clamp(30px,3.4vw,46px)] font-medium leading-[1.08]">Ashley Kagasoff</h2>
        <div class="mb-[30px] text-[12.5px] uppercase tracking-[0.16em] text-brasslight">Attorney at Law · Founder</div>
        <p class="mb-4 max-w-[64ch] text-[clamp(15.5px,0.95vw,19px)] font-light leading-[1.8] text-mist">
          Ashley has dedicated over 17 years to results-driven advocacy and personalized service.
          Her practice spans criminal defense, professional license defense, personal injury,
          employment, and family law — giving clients comprehensive solutions tailored to their needs.
        </p>
        <p class="mb-[38px] max-w-[64ch] text-[clamp(15.5px,0.95vw,19px)] font-light leading-[1.8] text-mist">
          Having worked both sides of the law — as a law clerk for the Orange County District
          Attorney's and Public Defender's offices, then fifteen years in private defense — she
          brings a rare perspective to every matter she takes on.
        </p>
        <div class="grid max-w-[62ch] grid-cols-1 gap-5 sm:grid-cols-3 sm:gap-7">
          {
            credentials.map((c) => (
              <div class="border-t border-[rgba(201,190,159,0.35)] pt-4">
                <div class="mb-[5px] font-serif text-[22px] font-medium text-paper">{c.k}</div>
                <div class="text-[13px] font-light leading-[1.5] text-mist">{c.v}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <PracticeCTA heading="Let's discuss your situation." sub="Your first consultation is free and confidential." />
</BaseLayout>
