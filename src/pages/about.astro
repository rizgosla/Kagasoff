---
/** About — "Plain English, legal structure." Hero (with a real-facts quick
    panel, no stock imagery), the attorney's real bio (BRIEF.md only), and a
    closing call to action. Two "empty trust slot" sections (a one-item
    values list, and an unnamed team) were cut per MASTER:286-290 ("Empty
    trust slots get REMOVED, not filled") — the NEEDS-CLIENT markers below
    are kept so they're trivial to restore once real content exists.
    See design-system/kagasoff-law-firm/MASTER.md. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import SectionIndex from '../components/SectionIndex.astro';

const credentials = [
  { k: '17+ years', v: 'Of practice' },
  { k: 'UCLA', v: 'B.A., 2003' },
  { k: 'Chapman', v: 'J.D., School of Law, 2007' },
];
---

<BaseLayout
  title="Ashley Kagasoff, Attorney — Westminster, CA | Kagasoff Law Firm, A.P.C."
  description="Ashley Kagasoff has practiced law in Westminster, CA for 17+ years, including as an Orange County DA's Office law clerk. See her background and credentials."
>
  <!-- HERO -->
  <section class="bg-paper">
    <div class="mx-auto grid max-w-page grid-cols-1 items-start gap-2xl px-lg py-section md:grid-cols-[1.3fr_1fr] md:px-2xl">
      <div data-reveal="left">
        <SectionIndex n={1} label="About the firm" />
        <h1 class="max-w-measure font-serif text-h1 font-medium text-ink" data-reveal>
          The same attorney handles your case, start to finish.
        </h1>
        <p class="mt-lg max-w-prose text-lead text-stone" data-reveal style="--reveal-delay:100ms">
          Kagasoff Law Firm, A.P.C. is based in Westminster and handles criminal defense, professional
          license defense, personal injury, employment, family law, restraining orders, and real estate
          matters across Orange County.
        </p>
      </div>

      <div
        class="rounded-md border border-line bg-sand px-lg py-lg shadow-card"
        data-reveal="right"
        style="--reveal-delay:120ms"
      >
        <p class="text-eyebrow uppercase text-clay">At a glance</p>
        <dl class="mt-lg flex flex-col gap-md">
          <div>
            <dt class="text-meta text-stone">Experience</dt>
            <dd class="font-serif text-h3 font-semibold text-ink">17+ years</dd>
          </div>
          <div class="border-t border-line pt-md">
            <dt class="text-meta text-stone">Based in</dt>
            <dd class="font-serif text-h3 font-semibold text-ink">Westminster, CA</dd>
          </div>
          <div class="border-t border-line pt-md">
            <dt class="text-meta text-stone">Practice areas</dt>
            <dd class="font-serif text-h3 font-semibold text-ink">7</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- THE ATTORNEY -->
  <section class="bg-ink text-paper">
    <div class="mx-auto grid max-w-page grid-cols-1 items-start gap-2xl px-lg py-section md:grid-cols-[0.82fr_1.18fr] md:px-2xl">
      <div data-reveal="left">
        <Photo
          src="/ashley-portrait.jpg"
          alt="Ashley Kagasoff, Attorney at Law"
          dark
          position="50% 25%"
          class="aspect-[4/5] w-full rounded-md shadow-card"
        />
      </div>

      <div data-reveal="right" style="--reveal-delay:120ms">
        <SectionIndex n={2} label="The attorney" dark />
        <h2 class="font-serif text-h2 font-medium text-paper">Ashley Kagasoff</h2>
        <p class="mt-2xs text-meta uppercase tracking-[0.08em] text-mist">Attorney at Law</p>

        <p class="mt-lg max-w-prose text-body text-mist">
          Ashley has practiced law for 17+ years. She started as a law clerk for the Orange County
          District Attorney's Office and the Orange County Public Defender's Office, then spent 15
          years in private defense practice.
        </p>
        <p class="mt-md max-w-prose text-body text-mist">
          She holds a B.A. from UCLA (2003) and a J.D. from Chapman University School of Law (2007).
          She is licensed to practice in California and admitted to the Eastern, Central, and Southern
          District Courts of California.
        </p>
        <p class="mt-md max-w-prose text-body text-mist">
          Ashley also represents professionals before state licensing boards, including the Medical
          Board of California, Board of Registered Nursing, Dental Board of California, Board of Real
          Estate, Contractors State License Board, State Bar of California, and California Commission
          on Teacher Credentialing.
        </p>

        <div class="mt-xl grid max-w-measure grid-cols-1 gap-lg sm:grid-cols-3">
          {
            credentials.map((c) => (
              <div class="border-t border-linedark pt-md">
                <div class="font-serif text-h3 font-semibold text-paper">{c.k}</div>
                <div class="mt-2xs text-meta text-mist">{c.v}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!--
    Two sections were cut here per MASTER:286-290 ("Empty trust slots get
    REMOVED, not filled"), each of which had nothing real to show:

    NEEDS-CLIENT: additional published firm values. Only "Attentiveness" is
    confirmed in BRIEF.md — a single-item "What to expect" list read as a
    list that lost its entries, and it collided with the practice-page
    template's own "What to expect" (4-step process) section. Restore under
    a different heading once more values are published.

    NEEDS-CLIENT: staff names, roles, and bios for an "Our team" section.
    BRIEF.md confirms a team photo exists (/team.jpg) but no names or roles
    to attach to it. Restore once the client provides them.
  -->

  <!-- CLOSING CTA -->
  <section class="bg-ink text-paper">
    <div class="mx-auto max-w-page px-lg py-section md:px-2xl">
      <SectionIndex n={3} label="Talk to a lawyer" dark />
      <div class="flex flex-col items-start gap-lg sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
        <h2 class="max-w-measure font-serif text-h2 font-medium text-paper">
          Talk to a lawyer, not an intake form.
        </h2>
        <div class="flex flex-col gap-md sm:flex-row sm:flex-wrap">
          <a
            href="tel:+16572184947"
            class="btn-clay lift inline-flex items-center justify-center rounded-md bg-clay px-lg py-md text-body font-semibold"
          >
            Call (657) 218-4947
          </a>
          <a
            href="/contact/"
            class="lift inline-flex items-center justify-center rounded-md border border-mist px-lg py-md text-body font-semibold text-paper"
          >
            Send a message
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
