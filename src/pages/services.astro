---
/** Services — all six practice areas consolidated onto one page.
    Navy hero with jump-chip nav, one alternating-background section per
    practice area (reusing the overview + cases markup from the old
    per-slug template) — each laid out as a two-column row with a detailed
    line-art scene beside the text, sides alternating per area — and a
    single shared closing CTA band.

    The six scenes borrow the home page process section's drawing
    vocabulary wholesale: one shared viewBox cropped tight to the artwork
    (48 26 374 248), navy 2.4 contours, navy 1.8 at 60% for interior
    detail (nothing lighter — at shipped size anything below that floor
    disappears), brass rationed to two or three marks per drawing, sheet
    fills to occlude, cream/gold washes for depth. No text and no UI
    chrome inside any of them; every panel is aria-hidden decorative. */
import BaseLayout from '../layouts/BaseLayout.astro';
import { practiceAreas } from '../data/practiceAreas';

/* The scenes, keyed by slug. Each is the inner markup of one SVG on the
   shared stage, injected with set:html — which is why the stroke classes
   below are declared under :global() in the stylesheet. Comments above
   each entry describe the composition; the class vocabulary is defined
   once in this page's <style> block (.svc-art). */
const areaScenes: Record<string, string> = {
  /* Personal injury — a car in profile that has met something.
     The car faces left as one closed silhouette whose bottom edge is cut
     by two wheel arches, so the sheet-filled wheels sit inside the body
     rather than over it. Details are kept to the vocabulary: two washed
     panes following the pillars with a B-pillar between, a beltline and
     two door seams split so nothing crosses, handles, a gold-washed headlight, a tail-light,
     rim-and-hub caps and a rocker wash bounded by its crease. The
     consequence is told quietly: a brass impact burst off the front
     fender (the one accent) and two bold skid segments that take over the
     ground hairline behind each wheel. The body stays whole. */
  'personal-injury': `
    <path class="ln sheet" d="M92 228 V192 C92 180 101 172 116 168 L184 156 L226 106 C233 98 245 94 259 94 H328 C343 94 356 100 365 112 L386 148 L402 156 C411 160 416 168 416 180 V228 H385 A33 33 0 0 0 319 228 H205 A33 33 0 0 0 139 228 Z" />
    <path class="wash-n" d="M208 213.5 H316 V226.5 H208 Z" />
    <path class="ln-t wash-n" d="M199 150 L232 110 Q235 104 242 104 H289 V150 Z" />
    <path class="ln-t wash-n" d="M299 150 V104 H340 C348 104 353 107 357 113 L375 146 Q377 150 372 150 Z" />
    <path class="ln-t" d="M222 158 H288 M300 158 H388" />
    <path class="ln-t" d="M216 164 V206 M294 164 V206" />
    <path class="ln-t" d="M270 172 H285 M334 172 H349" />
    <path class="ln-t" d="M100 212 H130 M210 212 H314" />
    <path class="ln-t wash" d="M101 194 V186 C101 183 103 182 107 182 H123 C126 182 127 184 126 187 L124 192 C123 194 121 195 119 195 Z" />
    <rect class="ln-t" x="399" y="170" width="8" height="20" rx="2.5" />
    <circle class="ln sheet" cx="172" cy="228" r="28" />
    <circle class="ln-t" cx="172" cy="228" r="17" />
    <circle class="ln-t" cx="172" cy="228" r="5" />
    <circle class="ln sheet" cx="352" cy="228" r="28" />
    <circle class="ln-t" cx="352" cy="228" r="17" />
    <circle class="ln-t" cx="352" cy="228" r="5" />
    <path class="ln-t" d="M60 258 H160 M246 258 H340" />
    <path class="ln" d="M186 258 H240 M366 258 H410" />
    <path class="br" d="M82 134 L90 156 M60 152 L78 168 M50 186 L72 186 M60 220 L78 204" />
    <path class="br-t" d="M52 166 L68 176 M54 206 L70 198" />
  `,

  /* Criminal defense — the scales, standing on the law.
     A closed book lies flat on the ground rule (cover line, navy-washed
     page block — the same three-mark book the process section draws),
     and the scales stand ON it: a small plinth, a flared column, the
     crossbeam, and two chain pairs dropping to brass dishes with a gold
     wash in each (the accent). A gavel rests beside the book, head on
     the ground, handle out to the right, its two collar bands the only
     other brass. The finial is navy, not brass — the pans are the thing
     worth looking at. */
  'criminal-defense': `
    <path class="ln-t" d="M60 258 H410" />
    <rect class="ln sheet" x="94" y="224" width="212" height="34" rx="4" />
    <path class="wash-n" d="M110 234 H292 V250 H110 Z" />
    <path class="ln-t" d="M108 233 H292" />
    <rect class="ln sheet" x="174" y="210" width="52" height="14" rx="3" />
    <path class="ln" d="M186 210 C188 200 193 196 200 196 C207 196 212 200 214 210" />
    <path class="ln" d="M200 196 V64" />
    <path class="ln" d="M112 78 H288" />
    <circle class="ln sheet" cx="200" cy="56" r="6.5" />
    <path class="ln-t" d="M116 80 L98 126 M116 80 L134 126 M284 80 L266 126 M284 80 L302 126" />
    <path class="br wash" d="M90 128 A30 30 0 0 0 142 128 Z" />
    <path class="br wash" d="M258 128 A30 30 0 0 0 310 128 Z" />
    <path class="ln sheet" d="M307 227 L355 179 L377 201 L329 249 Z" />
    <path class="br-t" d="M319 220 L336 237 M348 191 L365 208" />
    <path class="ln sheet" d="M355 222 L392 259 A5.5 5.5 0 0 1 384 267 L347 230 Z" />
  `,

  /* Professional license defense — the credential itself, on the wall.
     A framed certificate hung from a brass nail: outer frame, washed mat,
     inner sheet, text rules, a level signature flourish on its rule, and
     a rosette seal — two swallowtail ribbon tails drawn first, then the
     sheet-filled disc over them so the ring occludes the tail tops. The
     tails stop above the inner border. A chair-rail hairline behind
     grounds the wall. */
  'professional-license-defense': `
    <path class="ln-t" d="M60 256 H410" />
    <path class="ln-t" d="M235 44 L154 76 M235 44 L316 76" />
    <circle class="dot" cx="235" cy="42" r="4.5" />
    <rect class="ln sheet" x="112" y="74" width="246" height="172" rx="4" />
    <rect class="wash-n" x="112" y="74" width="246" height="172" rx="4" />
    <rect class="ln-t sheet" x="130" y="92" width="210" height="136" rx="2" />
    <path class="ln-t" d="M164 114 H306 M186 128 H284" />
    <path class="ln-t" d="M150 152 H288 M150 166 H262" />
    <path class="ln-t" d="M153 210 C155 203 159 199 163 200 C168 201 168 209 173 210 C180 211 183 204 191 205 C199 206 205 204 213 206 C221 208 228 205 234 206" />
    <path class="ln-t" d="M148 214 H240" />
    <path class="br-t wash" d="M287 195 L273 222 L280 218 L286 224 L298 197 Z" />
    <path class="br-t wash" d="M294 197 L306 224 L312 218 L319 222 L305 195 Z" />
    <circle class="sheet" cx="296" cy="192" r="15" />
    <circle class="br wash" cx="296" cy="192" r="15" />
    <circle class="br-t" cx="296" cy="192" r="7" />
  `,

  /* Restraining orders — a shield standing guard before the home.
     The house is drawn first: an open-top wall path under a closed,
     navy-washed roof with eave overhangs, a sheet-filled chimney seated
     on the slope, two cross-paned windows with sills, an arched washed
     door on a sheet-filled stoop with a brass knob. The shield comes
     after, sheet-filled, so it occludes the near corner and the ground
     line, which is split to stop at the walls. Quarter lines stop short
     of the boss and the brasslight inner border; the brass is spent on
     the boss — a gold-washed ring with a solid brass stud at its heart. */
  'restraining-orders': `
    <path class="ln-t" d="M60 256 H248 M398 256 H410" />
    <path class="ln" d="M248 148 V256 H398 V148" />
    <path class="ln wash-n" d="M236 148 L323 94 L410 148 Z" />
    <path class="ln sheet" d="M364 119.4 V92 H378 V128.1 Z" />
    <rect class="ln sheet" x="361" y="86" width="20" height="6" rx="1" />
    <path class="ln-t" d="M268 170 H298 V200 H268 Z M283 170 V200 M268 185 H298 M264 204 H302" />
    <path class="ln-t" d="M348 170 H378 V200 H348 Z M363 170 V200 M348 185 H378 M344 204 H382" />
    <path class="ln-t wash-n" d="M309 249 V220 A14 14 0 0 1 337 220 V249" />
    <circle class="dot" cx="331" cy="238" r="2.2" />
    <rect class="ln-t sheet" x="301" y="250" width="44" height="6" rx="1" />
    <path class="ln sheet" d="M172 58 C210 76 242 82 260 82 V166 C260 214 226 246 172 266 C118 246 84 214 84 166 V82 C102 82 134 76 172 58 Z" />
    <path class="br-t wash-n" d="M172 74 C202 88 228 93 244 93 V164 C244 202 216 230 172 250 C128 230 100 202 100 164 V93 C116 93 142 88 172 74 Z" />
    <path class="ln-t" d="M172 77 V139 M172 185 V247 M103 162 H149 M195 162 H241" />
    <circle class="br wash" cx="172" cy="162" r="19" />
    <circle class="dot" cx="172" cy="162" r="6" />
  `,

  /* Employment — the working life as a still life on a desk.
     The desk is the process section's table: one long washed rail. On
     it a briefcase stands upright — arched handle, lid seam, a navy
     wash along its base for weight, and two brass clasps straddling the
     seam (the accent). Beside it, two document sheets lie stacked, each
     with its page-edge hairline, and a pay envelope sits on top, flap
     lines meeting at the centre, a brasslight band around its middle. */
  employment: `
    <rect class="ln wash-n" x="60" y="250" width="350" height="10" rx="3" />
    <path class="ln" d="M146 112 V100 A12 12 0 0 1 158 88 H186 A12 12 0 0 1 198 100 V112" />
    <rect class="ln sheet" x="86" y="112" width="172" height="138" rx="10" />
    <path class="wash-n" d="M94 220 H250 V244 H94 Z" />
    <path class="ln-t" d="M86 154 H258" />
    <rect class="br sheet" x="118" y="146" width="16" height="15" rx="2" />
    <rect class="br sheet" x="210" y="146" width="16" height="15" rx="2" />
    <rect class="ln sheet" x="284" y="230" width="120" height="20" rx="3" />
    <path class="ln-t" d="M290 239 H398" />
    <rect class="ln sheet" x="292" y="210" width="104" height="20" rx="3" />
    <path class="ln-t" d="M298 219 H390" />
    <rect class="ln sheet" x="296" y="172" width="96" height="38" rx="3" />
    <path class="ln-t" d="M296 176 L344 198 L392 176" />
  `,

  /* Real estate — the house, and the key to it.
     A side-gable cottage: a closed roof plane whose gold wash fills the
     whole gable, eaves overhanging the walls, a sheet-filled fascia band
     beneath, a chimney straddling the right rake with a slope-cut base,
     mullioned windows with sills abutting their frames, and a flat-top
     door on a small stoop with the brass knob dot. The ground hairline
     is split to stop at the wall corners. Below, the key: shaft, two
     sheet-filled teeth flush under the shaft, and the heavy brass bow
     drawn last so it occludes the shaft end, brasslight ring inside it. */
  'real-estate': `
    <!-- ground hairline, stopped at the walls -->
    <path class="ln-t" d="M60 222 H144 M326 222 H410" />
    <!-- chimney straddling the right rake: slope-cut body, then cap -->
    <path class="ln sheet" d="M292 97.8 V66 H310 V111 Z" />
    <rect class="ln sheet" x="289" y="61" width="24" height="5" />
    <!-- walls -->
    <rect class="ln sheet" x="146" y="136" width="178" height="86" />
    <!-- roof: side-gable plane, wash fills it; fascia band beneath -->
    <path class="ln wash" d="M126 136 L194 86 H276 L344 136 Z" />
    <rect class="ln sheet" x="126" y="136" width="218" height="6" />
    <!-- windows: frame, mullions flush to the frame, sill -->
    <rect class="ln-t" x="168" y="160" width="32" height="34" />
    <path class="ln-t" d="M184 161.8 V192.2 M169.8 177 H182.2 M185.8 177 H198.2" />
    <path class="ln-t" d="M164 195.8 H204" />
    <rect class="ln-t" x="270" y="160" width="32" height="34" />
    <path class="ln-t" d="M286 161.8 V192.2 M271.8 177 H284.2 M287.8 177 H300.2" />
    <path class="ln-t" d="M266 195.8 H306" />
    <!-- door on its stoop, brass knob -->
    <path class="ln-t wash-n" d="M222 216 V162 H248 V216 Z" />
    <circle class="dot" cx="244" cy="190" r="3" />
    <rect class="ln sheet" x="214" y="216" width="42" height="6" />
    <!-- key: shaft, teeth occluding the shaft edge, bow over the shaft end -->
    <path class="ln sheet" d="M150 248 H346 V256 H150" />
    <rect class="ln sheet" x="318" y="256" width="10" height="10" />
    <rect class="ln sheet" x="336" y="256" width="10" height="14" />
    <circle class="br" cx="134" cy="252" r="16" />
    <circle class="br-t" cx="134" cy="252" r="8" />
  `,
};

/** Fallback for an unknown slug: the scales-on-book scene — the most
    practice-agnostic of the six — rather than an empty panel. */
const fallbackScene = areaScenes['criminal-defense'];
---

<BaseLayout
  title="Services — Kagasoff Law Firm, A.P.C."
  description="Six practice areas, one standard of care — personal injury, criminal defense, professional license defense, restraining orders, employment, and real estate."
>
  <!-- HERO -->
  <section class="starfield overflow-hidden text-paper">
    <div class="shell pb-12 pt-14 md:pb-[70px] md:pt-16">
      <p class="mb-5 text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight" data-reveal>Services</p>
      <h1 class="mb-[18px] font-serif text-[clamp(34px,5.1vw,66px)] font-medium leading-[1.06]" data-reveal style="--reveal-delay:80ms">
        Six areas. <span class="text-gold">One standard of care.</span>
      </h1>
      <div class="mb-7 h-0.5 w-[54px] bg-brass" data-reveal style="--reveal-delay:130ms"></div>
      <p class="mb-9 max-w-[62ch] text-[clamp(16px,1.05vw,20px)] font-light leading-[1.7] text-mist" data-reveal style="--reveal-delay:170ms">
        Whatever life brings, the firm provides the same direct, attorney-led counsel across every matter.
      </p>
      <div class="flex flex-wrap gap-2.5" data-reveal style="--reveal-delay:210ms">
        {
          practiceAreas.map((a) => (
            <a
              href={`#${a.slug}`}
              class="lift inline-block rounded-full border border-brass/50 px-4 py-2 text-[13px] font-medium tracking-[0.02em] text-paper"
            >
              {a.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PRACTICE AREA SECTIONS — text beside a line-art scene panel, sides alternating -->
  {
    practiceAreas.map((a, i) => (
      <section id={a.slug} class={i % 2 === 0 ? 'bg-paper' : 'bg-cream'}>
        <div class="shell py-14 md:py-[80px]">
          <div class={`grid grid-cols-1 gap-12 lg:items-center lg:gap-16 xl:gap-20 ${i % 2 === 0 ? 'lg:grid-cols-[1.08fr_0.92fr]' : 'lg:grid-cols-[0.92fr_1.08fr]'}`}>
            <!-- Text column -->
            <div class={i % 2 === 0 ? 'lg:order-1' : 'lg:order-2'}>
              <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass" data-reveal>
                {String(i + 1).padStart(2, '0')} &middot; Practice Area
              </p>
              <h2 class="mb-[18px] font-serif text-[clamp(29px,3.2vw,46px)] font-medium leading-[1.1] text-navy" data-reveal style="--reveal-delay:60ms">
                {a.name}
              </h2>
              <div class="mb-7 h-0.5 w-[54px] bg-brass" data-reveal style="--reveal-delay:100ms" />
              <p
                class="mb-9 max-w-[68ch] text-[clamp(16px,1.05vw,20px)] font-light leading-[1.7] text-ink"
                data-reveal
                style="--reveal-delay:130ms"
                set:html={a.blurb}
              />

              <div data-reveal style="--reveal-delay:160ms">
                {a.overview.map((p) => (
                  <p class="mb-[18px] max-w-[72ch] text-[clamp(15.5px,0.95vw,19px)] font-light leading-[1.8] text-ink" set:html={p} />
                ))}

                <h3 class="mb-5 mt-9 font-serif text-[22px] font-semibold text-navy md:text-[24px]" set:html={a.casesHeading} />
                <div class="grid grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2">
                  {a.cases.map((c) => (
                    <div class="flex items-baseline gap-3 text-[15px] text-navy">
                      <span class="text-brass">&mdash;</span>
                      <span set:html={c} />
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Decorative scene panel — the drawing on its mat, inside the offset frame -->
            <div
              class={`relative mx-auto w-full max-w-[340px] sm:max-w-[400px] lg:max-w-[520px] lg:justify-self-center ${i % 2 === 0 ? 'lg:order-2' : 'lg:order-1'}`}
              aria-hidden="true"
              data-reveal={i % 2 === 0 ? 'right' : 'left'}
              style="--reveal-delay:200ms"
            >
              <div class="pointer-events-none absolute -inset-2.5 rounded-[14px] border border-brass/40 md:-inset-4"></div>
              <div class="svc-mat relative">
                <svg
                  class="svc-art"
                  viewBox="48 26 374 248"
                  role="presentation"
                  focusable="false"
                  set:html={areaScenes[a.slug] ?? fallbackScene}
                />
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- CTA -->
  <section class="starfield overflow-hidden text-paper">
    <div class="shell py-14 text-center md:py-[70px]">
      <h2 class="mb-3.5 font-serif text-[clamp(28px,3.2vw,44px)] font-medium" data-reveal>Have a <span class="text-gold">matter?</span></h2>
      <p class="mb-[30px] text-[16px] font-light text-mist" data-reveal style="--reveal-delay:80ms">Let's talk today. Your first consultation is free and confidential.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:flex-wrap sm:justify-center" data-reveal style="--reveal-delay:140ms">
        <a href="tel:6572184947" class="btn-brass lift inline-block w-full rounded-[8px] bg-brass px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] sm:w-auto">Call (657) 218-4947</a>
        <a href="/#contact" class="lift inline-block w-full rounded-[8px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] text-paper sm:w-auto">Send a message</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* The mat under each drawing — the process section's .pc-visual:
     sheet warming into cream, hairline border, the 14px radius the rest
     of the page uses. The sheet colour also fills every shape that has
     to occlude another (see .sheet below). */
  .svc-mat {
    --svc-sheet: #fffdf9;
    border-radius: 14px;
    border: 1px solid var(--color-line);
    background: linear-gradient(180deg, var(--svc-sheet) 0%, var(--color-cream) 100%);
    overflow: hidden;
  }
  .svc-art {
    display: block;
    width: 100%;
    height: auto;
  }

  /* The stroke vocabulary, one-for-one with the process section's
     .pc-art classes. :global(), because the scenes are injected with
     set:html — Astro's scope attribute lands on elements in this
     template, never on nodes parsed out of a string. */
  /* Contour. */
  .svc-art :global(.ln) {
    fill: none;
    stroke: var(--color-navy);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Interior detail — rules, panes, window crosses. 1.8 at 60% is the
     floor: these panels ship at 300-440px on a ~374-unit viewBox, and
     anything lighter vanishes at that scale. */
  .svc-art :global(.ln-t) {
    fill: none;
    stroke: var(--color-navy);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* stroke-opacity, not opacity: several of these sit on the same
       element as a wash fill, and element opacity would fade both. */
    stroke-opacity: 0.6;
  }
  /* The accent, rationed to two or three marks per drawing. */
  .svc-art :global(.br) {
    fill: none;
    stroke: var(--color-brass);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .svc-art :global(.br-t) {
    fill: none;
    stroke: var(--color-brasslight);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Fills. Declared after the stroke classes so `class="ln sheet"` —
     an outlined shape that has to occlude what is behind it — resolves
     to the fill rather than to the stroke class's fill: none. */
  .svc-art :global(.sheet) { fill: var(--svc-sheet); }
  .svc-art :global(.wash) { fill: var(--color-gold); fill-opacity: 0.22; }
  .svc-art :global(.wash-n) { fill: var(--color-navy); fill-opacity: 0.07; }
  .svc-art :global(.dot) { fill: var(--color-brass); }
</style>
