---
/** Home — the single-page site. Section order: hero, why/practice split (with
    a sticky intake form), team hover cards, "with you step by step", about
    (vision + values), and the closing contact band with a second intake form
    and the office map. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import IntakeForm from '../components/IntakeForm.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import ProcessSection from '../components/ProcessSection.astro';
import { practiceAreas } from '../data/practiceAreas';

const stats = [
  { n: '20+', l: 'Years of experience' },
  { n: '4.6', l: 'Google rating' },
  { n: '6', l: 'Practice areas' },
];

const credentials = [
  { k: '20+ years', v: 'Of trial & advocacy experience' },
  { k: 'UCLA', v: 'B.A., 2003' },
  { k: 'Chapman', v: 'J.D., School of Law, 2007' },
];

const values = [
  { numeral: 'I.', title: 'Attentiveness', body: 'We stay fully present and engaged — listening to your concerns and shaping legal solutions around your unique situation.' },
  { numeral: 'II.', title: 'Relentless preparation', body: 'Every case is thoroughly prepared and strategized. That readiness is what creates leverage at the table.' },
  { numeral: 'III.', title: 'Straight answers', body: 'We tell you where you stand in plain language, so you can make decisions with confidence.' },
];
---

<BaseLayout>
  <!-- HERO — Style A split: staff photo + review proof over a navy starfield -->
  <section class="starfield overflow-hidden text-paper">
    <div class="grid shell grid-cols-1 items-center gap-12 pb-16 pt-14 md:grid-cols-[1.1fr_0.9fr] md:gap-16 xl:gap-24 md:pb-24 md:pt-20">
      <!-- Left: copy -->
      <div data-reveal="left">
        <p class="mb-6 text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight">Serving California</p>
        <h1 class="font-serif text-[clamp(40px,5.4vw,104px)] font-medium leading-[1.04] tracking-[0.005em]">
          Orange County<br />
          <span class="text-gold">Injury &amp; Defense</span><br />
          Attorneys.
        </h1>
        <p class="mt-7 max-w-[52ch] text-[clamp(16px,1.1vw,20px)] font-light leading-[1.75] text-mist">
          From the courtroom to the negotiating table, Kagasoff Law Firm brings care and attention
          to every client.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <a href="tel:6572184947" class="btn-brass lift inline-block rounded-[8px] bg-brass px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em]">Call (657) 218-4947</a>
          <a href="#contact" class="lift inline-block rounded-[8px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] text-paper">Free consultation</a>
        </div>
        <div class="mt-10">
          <TestimonialCarousel />
        </div>
      </div>

      <!-- Right: staff photo panel -->
      <div class="relative mx-auto w-full max-w-[560px] md:mx-0 md:max-w-none md:justify-self-stretch" data-reveal="right" style="--reveal-delay:140ms">
        <div aria-hidden="true" class="pointer-events-none absolute -inset-3 rounded-[14px] border border-[rgba(201,190,159,0.4)] md:-inset-4"></div>
        <div class="relative overflow-hidden rounded-[14px] bg-navydark shadow-[0_40px_80px_-40px_rgba(0,0,0,0.7)]">
          <img src="/team.jpg" alt="The Kagasoff Law Firm team" class="h-full w-full object-cover" style="aspect-ratio:4/5;max-height:min(78vh,760px);object-position:50% 35%" />
          <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[rgba(16,27,48,0.85)] to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <div class="inline-flex items-center gap-2 rounded-full bg-[rgba(16,27,48,0.72)] px-4 py-2 text-[12px] tracking-[0.04em] text-paper backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
              A team that fights for you
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY US + OUR PRACTICE, beside a sticky consultation form -->
  <section id="why" class="bg-cream">
    <div class="shell py-14 md:py-[84px]">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <!-- Left: why-us + the practice deck -->
        <div class="flex flex-col gap-14 md:gap-20">
          <!-- Why Kagasoff -->
          <div class="popout p-6 md:p-10">
            <div data-reveal="left">
              <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">Why Kagasoff</p>
              <h2 class="font-serif text-[clamp(26px,2.6vw,40px)] font-medium leading-[1.2] text-navy">
                The firm with proven results and decades of experience.
              </h2>
              <p class="mt-[18px] max-w-[46ch] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-ink">
                Personalized care and honest counsel that’s trusted by hundreds of clients.
              </p>
              <a href="#about" class="lift mt-6 inline-block border-b border-brass pb-1.5 text-sm font-semibold tracking-[0.05em] text-brass">More about the firm →</a>
            </div>
            <div class="mt-8 grid grid-cols-3 overflow-hidden rounded-[14px] border border-line bg-cream md:mt-12">
              {
                stats.map((s, i) => (
                  <div
                    class:list={[
                      'p-5 border-line',
                      i > 0 && 'border-l',
                    ]}
                    data-reveal
                    style={`--reveal-delay:${i * 100}ms`}
                  >
                    <div class="text-left font-serif text-[clamp(38px,3.6vw,58px)] font-medium leading-none text-brass">{s.n}</div>
                    <div class="mt-2.5 text-left text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.12em] text-ink">{s.l}</div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Our Practice -->
          <div id="practice" class="popout p-6 md:p-10">
            <div data-reveal="left">
              <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">Our Practice</p>
              <h2 class="font-serif text-[clamp(26px,2.6vw,40px)] font-medium leading-[1.2] text-navy">Six areas. One standard of care.</h2>
              <p class="mt-[18px] max-w-[46ch] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-ink">
                Whatever life brings, the firm provides the same direct, attorney-led counsel across every matter.
              </p>
            </div>

            <div class="deck-stage mt-10" id="practiceDeck">
              {
                practiceAreas.map((a, i) => (
                  <a href={`/services#${a.slug}`} class="kcard" data-pos={String(Math.min(i, 3))}>
                    <div class="kcard-top">
                      <span class="kcard-num">{String(i + 1).padStart(2, '0')}</span>
                      <span class="kcard-count">
                        {String(i + 1).padStart(2, '0')} / {String(practiceAreas.length).padStart(2, '0')}
                      </span>
                    </div>
                    <div class="kcard-body">
                      <h3>{a.name}</h3>
                      <p set:html={a.short} />
                    </div>
                    <span class="kcard-cta">
                      Learn more <span class="parrow">&rarr;</span>
                    </span>
                  </a>
                ))
              }
            </div>

            <div class="deck-bar mt-6">
              <button class="deck-arrow" id="deckPrev" type="button" aria-label="Previous practice area">
                <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <div class="deck-dots" id="deckDots"></div>
              <button class="deck-arrow" id="deckNext" type="button" aria-label="Next practice area">
                <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Right: sticky consultation form -->
        <div class="lg:sticky lg:top-24">
          <div data-reveal="right" style="--reveal-delay:120ms">
            <p class="mb-[10px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">Free Consultation</p>
            <p class="mb-6 font-serif text-[clamp(22px,1.7vw,30px)] leading-[1.3] text-navy">Tell us about your case.</p>
            <IntakeForm uid="a" heading="" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const stage = document.getElementById('practiceDeck');
      if (!stage) return;
      const cards = [...stage.querySelectorAll<HTMLElement>('.kcard')];
      const dotsEl = document.getElementById('deckDots');
      const nextBtn = document.getElementById('deckNext');
      const prevBtn = document.getElementById('deckPrev');
      if (!dotsEl || !nextBtn || !prevBtn) return;
      const N = cards.length;
      let cur = 0;
      let busy = false;

      for (let i = 0; i < N; i++) {
        const d = document.createElement('button');
        d.className = 'deck-dot';
        d.type = 'button';
        d.setAttribute('aria-label', 'Practice area ' + (i + 1));
        d.addEventListener('click', () => go(i));
        dotsEl.appendChild(d);
      }

      function setDots() {
        [...dotsEl!.children].forEach((d, i) => d.classList.toggle('on', i === cur));
      }

      function go(next: number) {
        if (busy || next === cur) return;
        busy = true;
        const exitIdx = cur;
        const top = cards[exitIdx];

        top.style.transition = 'transform .38s cubic-bezier(.4,0,.6,1), opacity .34s ease-in';
        top.style.transform = 'scale(0.94) translateY(6px)';
        top.style.opacity = '0';
        top.style.zIndex = '20';
        top.style.pointerEvents = 'none';

        // Advance immediately so the cards below animate to their new depth
        cur = ((next % N) + N) % N;
        cards.forEach((c, i) => {
          if (i === exitIdx) return;
          c.dataset.pos = String(Math.min((i - cur + N) % N, 3));
        });
        setDots();

        setTimeout(() => {
          // Snap the exited card to the back of the pile with no transition
          top.style.transition = 'none';
          top.style.transform = 'translateY(30px) scale(0.9)';
          top.style.opacity = '0';
          top.style.zIndex = '';
          top.style.pointerEvents = '';
          top.dataset.pos = String(Math.min((exitIdx - cur + N) % N, 3));
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              top.style.cssText = '';
              busy = false;
            }),
          );
        }, 450);
      }

      nextBtn.addEventListener('click', () => go((cur + 1) % N));
      prevBtn.addEventListener('click', () => go((cur - 1 + N) % N));

      let timer = setInterval(() => go((cur + 1) % N), 9000);
      stage.addEventListener('mouseenter', () => clearInterval(timer));
      stage.addEventListener('mouseleave', () => {
        timer = setInterval(() => go((cur + 1) % N), 9000);
      });

      setDots();
    })();
  </script>

  <!-- THE TEAM — static rows: portrait beside the full bio, alternating sides -->
  <section id="team" class="bg-navydark text-paper">
    <div class="shell py-14 md:py-[92px]">
      <div class="mb-11 max-w-[56ch] md:mb-14" data-reveal>
        <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight">The Team</p>
        <h2 class="font-serif text-[clamp(30px,3.4vw,48px)] font-medium leading-[1.1] text-paper">
          The people in your corner.
        </h2>
        <p class="mt-[18px] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-mist">
          Transparency and personal care, so you know who is handling your matter.
        </p>
      </div>

      <div class="mx-auto flex max-w-[1200px] flex-col gap-10 md:gap-12">
        <!-- Ashley Kagasoff — portrait left, bio right -->
        <article class="overflow-hidden rounded-[16px] border border-white/10 bg-navy md:grid md:grid-cols-[minmax(300px,420px)_1fr]" data-reveal>
          <img
            src="/ashley-portrait.jpg"
            alt="Ashley Kagasoff"
            class="aspect-[4/5] w-full object-cover md:aspect-auto md:h-full"
            style="object-position:78% 22%"
          />
          <div class="p-7 md:p-10 lg:p-12">
            <h3 class="font-serif text-[clamp(26px,2.2vw,36px)] font-medium leading-[1.1] text-paper">Ashley Kagasoff</h3>
            <p class="mt-2 text-[12.5px] uppercase tracking-[0.16em] text-brasslight">Attorney at Law</p>
            <p class="mt-6 text-[clamp(14.5px,0.9vw,17px)] font-light leading-[1.75] text-mist">
              Ashley has dedicated over two decades to results-driven advocacy and personalized legal
              service. Her practice areas span criminal defense, professional license defense, personal
              injury, and employment, giving clients comprehensive solutions tailored to their every needs.
            </p>
            <p class="mt-4 text-[clamp(14.5px,0.9vw,17px)] font-light leading-[1.75] text-mist">
              Having worked both sides of the law, as a law clerk for the Orange County District
              Attorney's and Public Defender's offices, then fifteen years in private defense, she
              brings a rare perspective to every matter she takes on.
            </p>
            <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-3">
              {
                credentials.map((c) => (
                  <div class="border-t border-[rgba(201,190,159,0.35)] pt-3">
                    <div class="mb-1.5 font-serif text-[clamp(26px,2vw,34px)] font-medium leading-none text-paper">{c.k}</div>
                    <div class="text-[13px] font-light leading-[1.5] text-mist">{c.v}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </article>

        <!-- Office manager — mirrored: bio left, portrait right -->
        <article class="overflow-hidden rounded-[16px] border border-white/10 bg-navy md:grid md:grid-cols-[1fr_minmax(300px,420px)]" data-reveal style="--reveal-delay:120ms">
          <Placeholder label="Office manager portrait — replace" class="aspect-[4/5] w-full md:order-2 md:aspect-auto md:h-full" />
          <div class="p-7 md:order-1 md:p-10 lg:p-12">
            <h3 class="font-serif text-[clamp(26px,2.2vw,36px)] font-medium leading-[1.1] text-paper">Melo</h3>
            <p class="mt-2 text-[12.5px] uppercase tracking-[0.16em] text-brasslight">Office Manager</p>
            <p class="mt-6 text-[clamp(14.5px,0.9vw,17px)] font-light leading-[1.75] text-mist">
              [SAMPLE BIO — replace with the office manager's real bio.] She is usually the first
              voice you'll hear when you call the firm, and she keeps every matter moving — scheduling
              consultations, gathering records, and making sure clients are never left wondering where
              their case stands. Clients regularly credit her with making a difficult process feel
              manageable.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- WITH YOU STEP BY STEP -->
  <ProcessSection />

  <!-- ABOUT — vision + what you can expect, merged into one popout -->
  <section id="about" class="bg-cream">
    <div class="shell pt-4 pb-14 md:pt-6 md:pb-[84px]">
      <div class="popout p-6 md:p-12">
        <div class="grid grid-cols-1 items-start gap-12 md:grid-cols-2 md:gap-14 lg:gap-20">
          <!-- Left: the mission, with its supporting copy directly beneath it -->
          <div data-reveal>
            <p class="mb-[16px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">About the Firm</p>
            <h2 class="font-serif text-[clamp(26px,2.4vw,40px)] font-medium leading-[1.25] text-navy">
              To provide exceptional legal counsel and representation that exceeds our clients' expectations.
            </h2>
            <div class="mt-7 h-0.5 w-[54px] bg-brass"></div>
            <p class="mt-7 max-w-[52ch] text-[clamp(15.5px,0.95vw,19px)] font-light leading-[1.8] text-ink">
              Based in Westminster and serving clients throughout California, the firm handles matters
              across six practice areas, from personal injury and criminal defense to employment and
              professional licensing. What unites that range is a single approach: thorough preparation,
              plain-spoken advice, and direct access to the attorney working on your case.
            </p>
          </div>

          <!-- Right: the three commitments, stacked as ruled rows -->
          <div>
            <p class="mb-[16px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass" data-reveal>What you can expect</p>
            {
              values.map((v, i) => (
                <div
                  class:list={['flex gap-6 py-6 md:gap-8', i > 0 && 'border-t border-line', i === 0 && 'pt-2']}
                  data-reveal
                  style={`--reveal-delay:${(i + 1) * 100}ms`}
                >
                  <div class="w-10 shrink-0 pt-0.5 font-serif text-[28px] leading-[1.1] text-brass">{v.numeral}</div>
                  <div>
                    <h3 class="font-serif text-[clamp(20px,1.4vw,25px)] font-semibold leading-[1.2] text-navy">{v.title}</h3>
                    <p class="mt-2 text-[clamp(14.5px,0.9vw,17px)] font-light leading-[1.7] text-ink">{v.body}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA + INTAKE + MAP -->
  <section id="contact" class="starfield overflow-hidden text-paper">
    <div class="shell py-16 md:py-[104px]">
      <div class="mb-12 max-w-[62ch] md:mb-16" data-reveal="left">
        <p class="mb-[18px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight">Free Initial Consultation</p>
        <h2 class="font-serif text-[clamp(32px,4.4vw,58px)] font-medium leading-[1.06]">
          Tell us <span class="text-gold">what happened.</span>
        </h2>
        <p class="mt-6 max-w-[52ch] text-[clamp(16px,1.05vw,20px)] font-light leading-[1.75] text-mist">
          Every consultation is free and confidential. We'll listen, tell you honestly where you
          stand, and lay out how we can help.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <a href="tel:6572184947" class="btn-brass lift inline-block rounded-[8px] bg-brass px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em]">Call (657) 218-4947</a>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14 items-stretch">
        <IntakeForm uid="b" />
        <div class="flex flex-col gap-6">
          <div class="overflow-hidden rounded-[14px] border border-white/10 min-h-[360px] flex-1">
            <iframe
              src="https://www.google.com/maps?q=14541+Brookhurst+St+Suite+D4,+Westminster,+CA+92683&output=embed"
              class="h-full w-full min-h-[360px] border-0"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              title="Kagasoff Law Firm office — 14541 Brookhurst St Suite D4, Westminster, CA"></iframe>
          </div>
          <div>
            <p class="mb-1 text-[11px] uppercase tracking-[0.22em] text-brasslight">Westminster Office</p>
            <p class="font-serif text-[19px] leading-[1.4] text-paper">14541 Brookhurst St, Suite D4<br />Westminster, CA 92683</p>
            <a href="tel:6572184947" class="mt-4 inline-flex items-center gap-2 text-[14px] text-paper">
              <span class="inline-block h-px w-4 bg-gold/50"></span>(657) 218-4947
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
