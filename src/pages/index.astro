---
/** Home — five numbered sections, in the shape of a legal document.
    § 01 hero · § 02 what we handle · § 03 who you'd be working with ·
    § 04 what happens when you call · § 05 consultation.
    See design-system/kagasoff-law-firm/MASTER.md. Every business fact here
    comes from BRIEF.md or src/data/practiceAreas.ts — nothing is invented. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import SectionIndex from '../components/SectionIndex.astro';
import { practiceAreas, process } from '../data/practiceAreas';

/* The hero's list of practice areas is generated, never typed out, so adding
   an area to practiceAreas.ts updates the sentence too. */
const names = practiceAreas.map((a) => a.name);
const areaSentence = `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;

/* The licensing boards are already structured data — reuse them rather than
   restating them. This is the most specific thing on the page. */
const licenseArea = practiceAreas.find((a) => a.slug === 'professional-license-defense');

/* Ashley Kagasoff's record. Each line is verbatim fact from BRIEF.md. */
const record: [string, string][] = [
  ['In practice', '17+ years'],
  [
    'Before private practice',
    'Law clerk, Orange County District Attorney&rsquo;s Office and Orange County Public Defender&rsquo;s Office',
  ],
  ['Private defense', '15 years'],
  [
    'Education',
    'B.A., University of California, Los Angeles, 2003. J.D., Chapman University School of Law, 2007.',
  ],
  [
    'Admitted',
    'California. U.S. District Courts for the Eastern, Central and Southern Districts of California.',
  ],
];
---

<BaseLayout>
  <!-- § 01 — HERO ------------------------------------------------------ -->
  <section class="bg-paper">
    <div class="mx-auto max-w-page pb-section pt-xl md:pt-2xl">
      <div class="pl-md md:pl-xl">
        <SectionIndex n={1} label="Westminster, California" />
      </div>

      <div class="grid gap-xl px-md md:grid-cols-[1.05fr_0.95fr] md:items-center md:gap-2xl md:px-xl">
        <div>
          <h1 class="text-balance font-serif text-h1 font-medium text-ink">
            A Westminster attorney for the problem you&rsquo;re dealing with now.
          </h1>
          <p class="mt-lg max-w-prose text-pretty text-lead text-stone">
            {areaSentence} &mdash; handled by the same lawyer from the first call to the last.
          </p>
          <div class="mt-xl flex flex-col gap-sm sm:flex-row sm:items-center sm:gap-md">
            <a
              href="/contact/"
              class="btn-clay lift inline-flex items-center justify-center rounded-md bg-clay px-lg py-md text-meta font-semibold"
            >
              Request a consultation
            </a>
            <a
              href="tel:+16572184947"
              class="lift inline-flex items-center justify-center rounded-md border border-ink px-lg py-md text-meta font-semibold text-ink"
            >
              Call (657) 218-4947
            </a>
          </div>
        </div>

        <figure>
          <Photo
            src="/ashley-portrait.jpg"
            alt="Ashley Kagasoff, attorney at Kagasoff Law Firm, A.P.C."
            priority
            position="50% 25%"
            class="aspect-[4/3] rounded-md shadow-card md:aspect-[4/5]"
          />
          <figcaption class="mt-sm text-meta text-stone">
            Ashley Kagasoff, Attorney at Law
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- § 02 — WHAT WE HANDLE --------------------------------------------- -->
  <section class="bg-sand">
    <div class="mx-auto max-w-page py-section">
      <div class="pl-md md:pl-xl">
        <SectionIndex n={2} label="Practice areas" />
      </div>

      <div class="px-md md:px-xl" data-reveal>
        <h2 class="font-serif text-h2 font-medium text-ink">What we handle</h2>
        <p class="mt-md max-w-prose text-pretty text-body text-stone">
          Seven areas of law. Each page lists the specific charges, claims or boards involved.
        </p>

        <ul class="mt-xl grid grid-cols-1 gap-md sm:grid-cols-2 lg:grid-cols-4">
          {
            practiceAreas.map((a, i) => (
              <li>
                <a
                  href={`/practice/${a.slug}/`}
                  class="related-card flex h-full flex-col rounded-md border border-line bg-paper p-lg"
                >
                  <span class="text-eyebrow font-semibold uppercase text-clay" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="mt-sm font-serif text-lead font-medium text-ink">{a.name}</h3>
                  <p class="mt-xs text-meta text-stone" set:html={a.short} />
                  <span class="mt-auto pt-md text-clay" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- § 03 — THE ATTORNEY ----------------------------------------------- -->
  <section class="bg-paper">
    <div class="mx-auto max-w-page py-section">
      <div class="pl-md md:pl-xl">
        <SectionIndex n={3} label="The attorney" />
      </div>

      <div
        class="grid gap-xl px-md md:grid-cols-[0.8fr_1.2fr] md:gap-2xl md:px-xl"
        data-reveal
      >
        <div>
          <h2 class="font-serif text-h2 font-medium text-ink">Who you&rsquo;d be working with</h2>
          <h3 class="mt-lg font-serif text-h3 font-medium text-ink">Ashley Kagasoff</h3>
          <p class="mt-2xs text-eyebrow font-semibold uppercase text-stone">Attorney at Law</p>
          <a
            href="/about/"
            class="lift mt-lg inline-flex items-center gap-xs border-b border-clay py-sm text-meta font-semibold text-clay"
          >
            Read Ashley Kagasoff&rsquo;s full biography
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <dl class="border-t border-line">
          {
            record.map(([term, detail]) => (
              <div class="grid gap-2xs border-b border-line py-md sm:grid-cols-[minmax(0,11rem)_1fr] sm:gap-md">
                <dt class="text-eyebrow font-semibold uppercase text-stone">{term}</dt>
                <dd class="text-body text-ink" set:html={detail} />
              </div>
            ))
          }
          {
            licenseArea && (
              <div class="grid gap-2xs border-b border-line py-md sm:grid-cols-[minmax(0,11rem)_1fr] sm:gap-md">
                <dt class="text-eyebrow font-semibold uppercase text-stone">
                  {licenseArea.casesHeading}
                </dt>
                <dd>
                  <ul class="grid gap-2xs sm:grid-cols-2 sm:gap-x-md">
                    {licenseArea.cases.map((board) => (
                      <li class="text-body text-ink">{board}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- § 04 — PROCESS ----------------------------------------------------- -->
  <section class="bg-sand">
    <div class="mx-auto max-w-page py-section">
      <div class="pl-md md:pl-xl">
        <SectionIndex n={4} label="Process" />
      </div>

      <div class="px-md md:px-xl">
        <div data-reveal>
          <h2 class="font-serif text-h2 font-medium text-ink">What happens when you call</h2>
          <p class="mt-md max-w-prose text-pretty text-body text-stone">
            Four steps. They are the same in every practice area.
          </p>
        </div>

        <ol class="mt-xl grid grid-cols-1 gap-lg sm:grid-cols-2 lg:grid-cols-4">
          {
            process.map((step, i) => (
              <li
                class="border-t border-ink/20 pt-md"
                data-reveal
                style={`--reveal-delay:${i * 90}ms`}
              >
                <span class="font-serif text-h3 text-clay" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <h3 class="mt-2xs font-serif text-lead font-semibold text-ink" set:html={step.title} />
                <p class="mt-xs text-meta text-stone" set:html={step.body} />
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- § 05 — CONSULTATION ------------------------------------------------ -->
  <section class="bg-ink">
    <div class="mx-auto max-w-page py-section">
      <div class="pl-md md:pl-xl">
        <SectionIndex n={5} label="Consultation" dark />
      </div>

      <div class="px-md md:px-xl" data-reveal>
        <h2 class="text-balance font-serif text-h2 font-medium text-paper">
          Talk to a lawyer, not an intake form.
        </h2>
        <p class="mt-md max-w-prose text-pretty text-body text-mist">
          The first consultation is free. Tell us what happened and we&rsquo;ll tell you honestly
          where you stand.
        </p>
        <div class="mt-xl flex flex-col gap-sm sm:flex-row sm:items-center sm:gap-md">
          <a
            href="/contact/"
            class="btn-clay lift inline-flex items-center justify-center rounded-md border border-claylight bg-clay px-lg py-md text-meta font-semibold"
          >
            Request a consultation
          </a>
          <a
            href="tel:+16572184947"
            class="lift inline-flex items-center justify-center rounded-md border border-mist px-lg py-md text-meta font-semibold text-paper"
          >
            Call (657) 218-4947
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
