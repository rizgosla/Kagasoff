---
/** Home — navy hero over the marble-columns image, the practice-area cards,
    the navy attorney band, and the closing cream CTA. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import PracticeCTA from '../components/PracticeCTA.astro';
import { practiceAreas } from '../data/practiceAreas';
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-navy text-paper">
    <img src="/hero.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover object-[50%_65%]" />
    <div class="absolute inset-0 bg-[rgba(22,36,61,0.75)]"></div>
    <div class="relative mx-auto max-w-[1180px] px-5 pb-16 pt-14 text-center md:px-10 md:pb-[112px] md:pt-[104px]">
      <p class="mb-[26px] text-xs uppercase tracking-[0.32em] text-brasslight">Serving California</p>
      <h1 class="mx-auto max-w-[780px] font-serif text-[38px] font-medium leading-[1.1] tracking-[0.005em] md:text-[66px] md:leading-[1.05]">
        Trusted counsel<br />when it matters most.
      </h1>
      <div class="mx-auto my-[34px] h-0.5 w-[54px] bg-brass"></div>
      <p class="mx-auto mb-10 max-w-[580px] text-[16px] font-light leading-[1.7] text-mist md:text-[17px]">
        From the courtroom to the negotiating table, the Kagasoff Law Firm brings disciplined,
        personal advocacy to every client across seven practice areas.
      </p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:flex-wrap sm:justify-center">
        <a href="tel:6572184947" class="lift inline-block w-full rounded-[7px] bg-brass px-9 py-[18px] text-center text-[15px] font-semibold tracking-[0.04em] text-navy sm:w-auto">Call (657) 218-4947</a>
        <a href="/contact" class="lift inline-block w-full rounded-[7px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[15px] font-semibold tracking-[0.04em] text-paper sm:w-auto">Request a free consultation</a>
      </div>
    </div>
  </section>

  <!-- PRACTICE AREAS -->
  <section class="mx-auto max-w-[1180px] px-5 py-14 md:px-10 md:py-[84px]">
    <div class="deck-layout">
      <!-- left: copy + deck controls -->
      <div class="deck-copy">
        <div class="deck-heading">
          <p class="mb-[14px] text-xs uppercase tracking-[0.32em] text-brass">Our Practice</p>
          <h2 class="font-serif text-[26px] font-medium leading-[1.2] text-navy md:text-[34px]">Seven areas. One standard of care.</h2>
          <p class="mt-[18px] max-w-[440px] text-[15px] font-light leading-[1.75] text-ink">
            Whatever life brings, the firm provides the same direct, attorney-led counsel across every matter.
          </p>
        </div>
        <div class="deck-bar">
          <button class="deck-arrow" id="deckPrev" type="button" aria-label="Previous practice area">
            <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" /></svg>
          </button>
          <div class="deck-dots" id="deckDots"></div>
          <button class="deck-arrow" id="deckNext" type="button" aria-label="Next practice area">
            <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg>
          </button>
        </div>
      </div>

      <!-- right: moving card deck -->
      <div class="deck-stage" id="practiceDeck">
        {
          practiceAreas.map((a, i) => (
            <a href={`/practice/${a.slug}`} class="kcard" data-pos={String(Math.min(i, 3))}>
              <div class="kcard-top">
                <span class="kcard-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="kcard-count">
                  {String(i + 1).padStart(2, '0')} / {String(practiceAreas.length).padStart(2, '0')}
                </span>
              </div>
              <div class="kcard-body">
                <h3>{a.name}</h3>
                <p set:html={a.short} />
              </div>
              <span class="kcard-cta">
                Learn more <span class="parrow">&rarr;</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    (function () {
      const stage = document.getElementById('practiceDeck');
      if (!stage) return;
      const cards = [...stage.querySelectorAll<HTMLElement>('.kcard')];
      const dotsEl = document.getElementById('deckDots');
      const nextBtn = document.getElementById('deckNext');
      const prevBtn = document.getElementById('deckPrev');
      if (!dotsEl || !nextBtn || !prevBtn) return;
      const N = cards.length;
      let cur = 0;
      let busy = false;

      for (let i = 0; i < N; i++) {
        const d = document.createElement('button');
        d.className = 'deck-dot';
        d.type = 'button';
        d.setAttribute('aria-label', 'Practice area ' + (i + 1));
        d.addEventListener('click', () => go(i));
        dotsEl.appendChild(d);
      }

      function setDots() {
        [...dotsEl!.children].forEach((d, i) => d.classList.toggle('on', i === cur));
      }

      function go(next: number) {
        if (busy || next === cur) return;
        busy = true;
        const exitIdx = cur;
        const top = cards[exitIdx];

        const mobile = window.innerWidth <= 680;
        if (mobile) {
          // On mobile: fade + scale so no horizontal overflow triggers page zoom
          top.style.transition = 'transform .35s cubic-bezier(.4,0,.6,1), opacity .32s ease-in';
          top.style.transform = 'scale(0.88)';
        } else {
          // Desktop: slide the top card off to the right
          top.style.transition = 'transform .42s cubic-bezier(.4,0,.6,1), opacity .38s ease-in';
          top.style.transform = 'translateX(115%)';
        }
        top.style.opacity = '0';
        top.style.zIndex = '20';
        top.style.pointerEvents = 'none';

        // Advance immediately so the cards below animate to their new depth
        cur = ((next % N) + N) % N;
        cards.forEach((c, i) => {
          if (i === exitIdx) return;
          c.dataset.pos = String(Math.min((i - cur + N) % N, 3));
        });
        setDots();

        setTimeout(() => {
          // Snap the exited card to the back of the pile with no transition
          top.style.transition = 'none';
          top.style.transform = 'translateY(30px) scale(0.9)';
          top.style.opacity = '0';
          top.style.zIndex = '';
          top.style.pointerEvents = '';
          top.dataset.pos = String(Math.min((exitIdx - cur + N) % N, 3));
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              top.style.cssText = '';
              busy = false;
            }),
          );
        }, 450);
      }

      nextBtn.addEventListener('click', () => go((cur + 1) % N));
      prevBtn.addEventListener('click', () => go((cur - 1 + N) % N));

      let timer = setInterval(() => go((cur + 1) % N), 9000);
      stage.addEventListener('mouseenter', () => clearInterval(timer));
      stage.addEventListener('mouseleave', () => {
        timer = setInterval(() => go((cur + 1) % N), 9000);
      });

      setDots();
    })();
  </script>

  <!-- ATTORNEY BAND -->
  <section class="bg-navydark text-paper">
    <div class="mx-auto grid max-w-[1180px] grid-cols-1 items-center gap-10 px-5 py-14 md:grid-cols-[0.82fr_1.18fr] md:gap-[92px] md:px-10 md:py-[100px]">
      <div class="relative">
        <div aria-hidden="true" class="pointer-events-none absolute rounded-[4px] border border-[rgba(201,190,159,0.45)]" style="inset:20px -20px -20px 20px"></div>
        <Photo src="/ashley-portrait.jpg" alt="Ashley Kagasoff" dark position="50% 25%" class="relative min-h-[320px] rounded-[4px] md:min-h-[480px]" />
      </div>

      <div>
        <p class="mb-[26px] text-xs uppercase tracking-[0.32em] text-brasslight">A Lawyer Who Fights For You</p>
        <h2 class="mb-2 font-serif text-[36px] font-medium leading-[1.05] text-paper md:text-[52px] md:leading-[1.02]">Ashley Kagasoff</h2>
        <div class="mb-[38px] text-[12.5px] uppercase tracking-[0.16em] text-brasslight">Attorney</div>
        <p class="mb-10 max-w-[580px] text-[15.5px] font-light leading-[1.8] text-mist">
          Every matter is handled directly by an attorney who knows your name and your goals. We
          prepare each case as if it will be tried — because that preparation is what earns the
          strongest outcomes.
        </p>
        <a href="/about" class="lift inline-block border-b border-brass pb-1.5 text-sm font-semibold tracking-[0.05em] text-gold">More about the firm →</a>
      </div>
    </div>
  </section>

  <PracticeCTA />
</BaseLayout>
