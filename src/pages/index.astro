---
/** Home — the single-page site. Section order: hero, why/practice split (with
    a sticky intake form), team hover cards, "with you step by step", about
    (vision + values), and the closing contact band with a second intake form
    and the office map. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Placeholder from '../components/Placeholder.astro';
import IntakeForm from '../components/IntakeForm.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import { practiceAreas, process } from '../data/practiceAreas';

const stats = [
  { n: '17+', l: 'Years of experience' },
  { n: '5.0', l: 'Google rating' },
  { n: '291', l: 'Client reviews' },
  { n: '7', l: 'Practice areas' },
];

const credentials = [
  { k: '17+ years', v: 'Of trial & advocacy experience' },
  { k: 'UCLA', v: 'B.A., 2003' },
  { k: 'Chapman', v: 'J.D., School of Law, 2007' },
];

const values = [
  { numeral: 'I.', title: 'Attentiveness', body: 'We stay fully present and engaged — listening to your concerns and shaping legal solutions around your unique situation.' },
  { numeral: 'II.', title: 'Relentless preparation', body: 'Every case is prepared as if it will be tried. That readiness is what creates leverage at the table.' },
  { numeral: 'III.', title: 'Straight answers', body: 'We tell you where you stand in plain language, so you can make decisions with confidence.' },
];

/** One small line-drawn glyph per process step, in step order:
    phone handset · document · balance scales · gavel. */
const stepIcons = [
  ['M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z'],
  ['M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z', 'M14 2v6h6', 'M8 12h8', 'M8 16h8', 'M8 8h2'],
  ['M12 4v16', 'M8 20h8', 'M4.5 7h15', 'M1.5 13 4.5 7l3 6', 'M1.5 13a3 3 0 0 0 6 0', 'M16.5 13 19.5 7l3 6', 'M16.5 13a3 3 0 0 0 6 0'],
  ['M11.9 5.1 18.9 12.1 16.1 14.9 9.1 7.9Z', 'M12.5 11.5 5 19', 'M2 21h9'],
];
---

<BaseLayout>
  <!-- HERO — Style A split: staff photo + review proof over a navy starfield -->
  <section class="starfield overflow-hidden text-paper">
    <div class="grid shell grid-cols-1 items-center gap-12 pb-16 pt-14 md:grid-cols-[1.1fr_0.9fr] md:gap-16 xl:gap-24 md:pb-24 md:pt-20">
      <!-- Left: copy -->
      <div data-reveal="left">
        <p class="mb-6 text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight">Westminster &middot; Serving California</p>
        <h1 class="font-serif text-[clamp(40px,5.4vw,104px)] font-medium leading-[1.04] tracking-[0.005em]">
          Orange County<br />
          <span class="text-gold">injury &amp; defense</span><br />
          attorneys.
        </h1>
        <p class="mt-7 max-w-[52ch] text-[clamp(16px,1.1vw,20px)] font-light leading-[1.75] text-mist">
          From the courtroom to the negotiating table, the Kagasoff Law Firm brings disciplined,
          personal advocacy to every client &mdash; across seven practice areas.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <a href="tel:6572184947" class="lift inline-block rounded-[7px] bg-brass px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] text-navy">Call (657) 218-4947</a>
          <a href="#contact" class="lift inline-block rounded-[7px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] text-paper">Free consultation</a>
        </div>
        <div class="mt-10">
          <TestimonialCarousel />
        </div>
      </div>

      <!-- Right: staff photo panel -->
      <div class="relative mx-auto w-full max-w-[560px] md:mx-0 md:max-w-none md:justify-self-stretch" data-reveal="right" style="--reveal-delay:140ms">
        <div aria-hidden="true" class="pointer-events-none absolute -inset-3 rounded-[14px] border border-[rgba(201,190,159,0.4)] md:-inset-4"></div>
        <div class="relative overflow-hidden rounded-[10px] bg-navydark shadow-[0_40px_80px_-40px_rgba(0,0,0,0.7)]">
          <img src="/team.jpg" alt="The Kagasoff Law Firm team" class="h-full w-full object-cover" style="aspect-ratio:4/5;max-height:min(78vh,760px);object-position:50% 35%" />
          <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[rgba(16,27,48,0.85)] to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <div class="inline-flex items-center gap-2 rounded-full bg-[rgba(16,27,48,0.72)] px-4 py-2 text-[12px] tracking-[0.04em] text-paper backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
              A team that fights for you
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY US + OUR PRACTICE, beside a sticky consultation form -->
  <section id="why" class="bg-cream">
    <div class="shell py-14 md:py-[84px]">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
        <!-- Left: why-us + the practice deck -->
        <div class="flex flex-col gap-14 md:gap-20">
          <!-- Why Kagasoff -->
          <div>
            <div data-reveal="left">
              <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">Why Kagasoff</p>
              <h2 class="font-serif text-[clamp(26px,2.6vw,40px)] font-medium leading-[1.2] text-navy">
                A boutique firm with a courtroom record.
              </h2>
              <p class="mt-[18px] max-w-[46ch] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-ink">
                Direct access to your attorney, honest counsel, and preparation that holds up at trial —
                trusted by hundreds of Orange County clients.
              </p>
              <a href="#about" class="lift mt-6 inline-block border-b border-brass pb-1.5 text-sm font-semibold tracking-[0.05em] text-brass">Read our story →</a>
            </div>
            <div class="mt-10 grid grid-cols-2 gap-x-6 gap-y-8 md:mt-12">
              {
                stats.map((s, i) => (
                  <div class="border-t border-brass/30 pt-4" data-reveal style={`--reveal-delay:${i * 100}ms`}>
                    <div class="font-serif text-[clamp(38px,3.6vw,58px)] font-medium leading-none text-brass">{s.n}</div>
                    <div class="mt-2.5 text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.12em] text-ink">{s.l}</div>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Our Practice -->
          <div id="practice">
            <div data-reveal="left">
              <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">Our Practice</p>
              <h2 class="font-serif text-[clamp(26px,2.6vw,40px)] font-medium leading-[1.2] text-navy">Seven areas. One standard of care.</h2>
              <p class="mt-[18px] max-w-[46ch] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-ink">
                Whatever life brings, the firm provides the same direct, attorney-led counsel across every matter.
              </p>
            </div>

            <div class="deck-stage mt-10" id="practiceDeck">
              {
                practiceAreas.map((a, i) => (
                  <a href={`/services#${a.slug}`} class="kcard" data-pos={String(Math.min(i, 3))}>
                    <div class="kcard-top">
                      <span class="kcard-num">{String(i + 1).padStart(2, '0')}</span>
                      <span class="kcard-count">
                        {String(i + 1).padStart(2, '0')} / {String(practiceAreas.length).padStart(2, '0')}
                      </span>
                    </div>
                    <div class="kcard-body">
                      <h3>{a.name}</h3>
                      <p set:html={a.short} />
                    </div>
                    <span class="kcard-cta">
                      Learn more <span class="parrow">&rarr;</span>
                    </span>
                  </a>
                ))
              }
            </div>

            <div class="deck-bar mt-6">
              <button class="deck-arrow" id="deckPrev" type="button" aria-label="Previous practice area">
                <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <div class="deck-dots" id="deckDots"></div>
              <button class="deck-arrow" id="deckNext" type="button" aria-label="Next practice area">
                <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6" /></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Right: sticky consultation form -->
        <div class="lg:sticky lg:top-24">
          <div data-reveal="right" style="--reveal-delay:120ms">
            <p class="mb-[10px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">Free Consultation</p>
            <p class="mb-6 font-serif text-[clamp(22px,1.7vw,30px)] leading-[1.3] text-navy">Tell us about your case.</p>
            <IntakeForm uid="a" heading="" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const stage = document.getElementById('practiceDeck');
      if (!stage) return;
      const cards = [...stage.querySelectorAll<HTMLElement>('.kcard')];
      const dotsEl = document.getElementById('deckDots');
      const nextBtn = document.getElementById('deckNext');
      const prevBtn = document.getElementById('deckPrev');
      if (!dotsEl || !nextBtn || !prevBtn) return;
      const N = cards.length;
      let cur = 0;
      let busy = false;

      for (let i = 0; i < N; i++) {
        const d = document.createElement('button');
        d.className = 'deck-dot';
        d.type = 'button';
        d.setAttribute('aria-label', 'Practice area ' + (i + 1));
        d.addEventListener('click', () => go(i));
        dotsEl.appendChild(d);
      }

      function setDots() {
        [...dotsEl!.children].forEach((d, i) => d.classList.toggle('on', i === cur));
      }

      function go(next: number) {
        if (busy || next === cur) return;
        busy = true;
        const exitIdx = cur;
        const top = cards[exitIdx];

        top.style.transition = 'transform .38s cubic-bezier(.4,0,.6,1), opacity .34s ease-in';
        top.style.transform = 'scale(0.94) translateY(6px)';
        top.style.opacity = '0';
        top.style.zIndex = '20';
        top.style.pointerEvents = 'none';

        // Advance immediately so the cards below animate to their new depth
        cur = ((next % N) + N) % N;
        cards.forEach((c, i) => {
          if (i === exitIdx) return;
          c.dataset.pos = String(Math.min((i - cur + N) % N, 3));
        });
        setDots();

        setTimeout(() => {
          // Snap the exited card to the back of the pile with no transition
          top.style.transition = 'none';
          top.style.transform = 'translateY(30px) scale(0.9)';
          top.style.opacity = '0';
          top.style.zIndex = '';
          top.style.pointerEvents = '';
          top.dataset.pos = String(Math.min((exitIdx - cur + N) % N, 3));
          requestAnimationFrame(() =>
            requestAnimationFrame(() => {
              top.style.cssText = '';
              busy = false;
            }),
          );
        }, 450);
      }

      nextBtn.addEventListener('click', () => go((cur + 1) % N));
      prevBtn.addEventListener('click', () => go((cur - 1 + N) % N));

      let timer = setInterval(() => go((cur + 1) % N), 9000);
      stage.addEventListener('mouseenter', () => clearInterval(timer));
      stage.addEventListener('mouseleave', () => {
        timer = setInterval(() => go((cur + 1) % N), 9000);
      });

      setDots();
    })();
  </script>

  <!-- THE TEAM — portrait cards that reveal a bio on hover / tap -->
  <section id="team" class="bg-navydark text-paper">
    <div class="shell py-14 md:py-[92px]">
      <div class="mb-11 max-w-[56ch] md:mb-14" data-reveal>
        <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight">The Team</p>
        <h2 class="font-serif text-[clamp(30px,3.4vw,48px)] font-medium leading-[1.1] text-paper">
          The people in your corner.
        </h2>
        <p class="mt-[18px] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-mist">
          A small team, on purpose — so you always know who is handling your matter.
          Hover over a card (or tap it on a phone) to read their full bio.
        </p>
      </div>

      <div class="grid gap-8 sm:grid-cols-2 max-w-[1100px] mx-auto">
        <!-- Ashley Kagasoff -->
        <div class="teamcard" data-reveal>
          <img src="/ashley-portrait.jpg" alt="Ashley Kagasoff" class="absolute inset-0 h-full w-full object-cover" style="object-position:50% 25%" />
          <div class="teamcard-base">
            <h3 class="font-serif text-[clamp(24px,2vw,32px)] font-medium leading-[1.1] text-paper">Ashley Kagasoff</h3>
            <p class="mt-1.5 text-[12.5px] uppercase tracking-[0.16em] text-brasslight">Attorney at Law &middot; Founder</p>
            <button type="button" class="teamcard-hint" aria-expanded="false" aria-controls="teamcard-bio-ashley">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
              <span class="hint-hover">Hover to learn more</span><span class="hint-tap">Tap to learn more</span>
            </button>
          </div>
          <div class="teamcard-bio" id="teamcard-bio-ashley">
            <h3 class="font-serif text-[clamp(22px,1.8vw,28px)] font-medium leading-[1.1] text-paper">Ashley Kagasoff</h3>
            <div class="mt-1.5 mb-4 text-[12px] uppercase tracking-[0.16em] text-brasslight">Attorney at Law &middot; Founder</div>
            <p class="mb-3 text-[clamp(13.5px,0.85vw,15.5px)] font-light leading-[1.7] text-mist">
              Ashley has dedicated over 17 years to results-driven advocacy and personalized service.
              Her practice spans criminal defense, professional license defense, personal injury,
              employment, and family law — giving clients comprehensive solutions tailored to their needs.
            </p>
            <p class="mb-5 text-[clamp(13.5px,0.85vw,15.5px)] font-light leading-[1.7] text-mist">
              Having worked both sides of the law — as a law clerk for the Orange County District
              Attorney's and Public Defender's offices, then fifteen years in private defense — she
              brings a rare perspective to every matter she takes on.
            </p>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 sm:gap-4">
              {
                credentials.map((c) => (
                  <div class="border-t border-[rgba(201,190,159,0.35)] pt-2.5">
                    <div class="mb-[3px] font-serif text-[17px] font-medium text-paper">{c.k}</div>
                    <div class="text-[11.5px] font-light leading-[1.45] text-mist">{c.v}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <!-- Office manager -->
        <div class="teamcard" data-reveal style="--reveal-delay:120ms">
          <Placeholder label="Office manager portrait — replace" class="absolute inset-0" />
          <div class="teamcard-base">
            <h3 class="font-serif text-[clamp(24px,2vw,32px)] font-medium leading-[1.1] text-paper">Office Manager Name</h3>
            <p class="mt-1.5 text-[12.5px] uppercase tracking-[0.16em] text-brasslight">Office Manager</p>
            <button type="button" class="teamcard-hint" aria-expanded="false" aria-controls="teamcard-bio-office-manager">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
              <span class="hint-hover">Hover to learn more</span><span class="hint-tap">Tap to learn more</span>
            </button>
          </div>
          <div class="teamcard-bio" id="teamcard-bio-office-manager">
            <h3 class="font-serif text-[clamp(22px,1.8vw,28px)] font-medium leading-[1.1] text-paper">Office Manager Name</h3>
            <div class="mt-1.5 mb-4 text-[12px] uppercase tracking-[0.16em] text-brasslight">Office Manager</div>
            <p class="text-[clamp(13.5px,0.85vw,15.5px)] font-light leading-[1.7] text-mist">
              [SAMPLE BIO — replace with the office manager's real bio.] She is usually the first
              voice you'll hear when you call the firm, and she keeps every matter moving — scheduling
              consultations, gathering records, and making sure clients are never left wondering where
              their case stands. Clients regularly credit her with making a difficult process feel
              manageable.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const cards = [...document.querySelectorAll<HTMLElement>('.teamcard')];
      if (!cards.length) return;

      // The hint button is the accessible control (Enter/Space work natively);
      // clicking anywhere else on the card is a pointer-only convenience.
      function toggle(card: HTMLElement) {
        const open = !card.classList.contains('is-open');
        cards.forEach((c) => {
          const on = c === card && open;
          c.classList.toggle('is-open', on);
          c.querySelector('.teamcard-hint')?.setAttribute('aria-expanded', String(on));
        });
      }

      cards.forEach((card) => {
        card.querySelector('.teamcard-hint')?.addEventListener('click', () => toggle(card));
        card.addEventListener('click', (e) => {
          // The button fires its own handler; don't double-toggle.
          if ((e.target as Element).closest('.teamcard-hint')) return;
          toggle(card);
        });
      });
    })();
  </script>

  <!-- WITH YOU STEP BY STEP -->
  <section class="bg-paper">
    <div class="shell py-14 md:py-[88px]">
      <div class="mb-11 max-w-[56ch] md:mb-14" data-reveal>
        <p class="mb-[14px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">With You Step by Step</p>
        <h2 class="font-serif text-[clamp(26px,2.6vw,40px)] font-medium leading-[1.2] text-navy">
          What working with us looks like.
        </h2>
        <p class="mt-[18px] text-[clamp(15px,0.95vw,19px)] font-light leading-[1.75] text-ink">
          A clear, four-step path from your first call to resolution — we stay beside you at every
          stage, with the same disciplined approach across every practice area.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-x-8 gap-y-9 sm:grid-cols-2 lg:grid-cols-4 xl:gap-x-12">
        {
          process.map((step, i) => (
            <div class="border-t border-line pt-5" data-reveal style={`--reveal-delay:${i * 110}ms`}>
              <div class="step-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {stepIcons[i]?.map((d) => <path d={d} />)}
                </svg>
              </div>
              <div class="mb-3 font-serif text-[28px] leading-none text-brass">{String(i + 1).padStart(2, '0')}</div>
              <h3 class="mb-2 font-serif text-[clamp(21px,1.35vw,26px)] font-semibold leading-[1.2] text-navy" set:html={step.title} />
              <p class="text-[clamp(14px,0.85vw,17px)] font-light leading-[1.65] text-ink" set:html={step.body} />
            </div>
          ))
        }
      </div>
      <div class="mt-11 md:mt-14" data-reveal>
        <a href="#contact" class="lift inline-block rounded-[7px] bg-navy px-[30px] py-4 text-center text-sm font-semibold tracking-[0.04em] text-paper">Start with a free consultation →</a>
      </div>
    </div>
  </section>

  <!-- ABOUT — vision + what you can expect -->
  <section id="about">
    <div class="grid shell grid-cols-1 items-start gap-10 py-14 md:grid-cols-2 md:gap-16 md:py-[78px]">
      <div data-reveal="left">
        <p class="mb-[18px] text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass">Our Vision</p>
        <p class="mb-6 font-serif text-[clamp(23px,1.75vw,34px)] leading-[1.4] text-navy">
          To provide exceptional legal counsel and representation that exceeds our clients' expectations.
        </p>
        <p class="text-[clamp(15.5px,0.95vw,19px)] font-light leading-[1.8] text-ink">
          Based in Westminster and serving clients throughout Orange County and the greater California
          region, the firm handles matters across seven practice areas — from personal injury and
          criminal defense to family law and professional licensing. What unites that range is a single
          approach: thorough preparation, plain-spoken advice, and direct access to the attorney working
          on your case.
        </p>
      </div>
      <div class="relative" data-reveal="right" style="--reveal-delay:120ms">
        <div aria-hidden="true" class="pointer-events-none absolute rounded-[6px] border border-[rgba(156,122,60,0.5)]" style="inset:-16px 16px 16px -16px"></div>
        <Photo src="/team.jpg" alt="The Kagasoff Law Firm team" position="50% 30%" class="relative min-h-[clamp(280px,34vw,560px)] rounded-[6px]" />
      </div>
    </div>

    <div class="bg-cream">
      <div class="shell py-14 md:py-[74px]">
        <p class="mb-4 text-center text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brass" data-reveal>Our Commitment</p>
        <h2 class="mb-10 text-center font-serif text-[30px] font-medium text-navy md:mb-[52px] md:text-[40px]" data-reveal style="--reveal-delay:80ms">What you can expect</h2>
        <div class="grid grid-cols-1 gap-10 sm:grid-cols-3 sm:gap-12">
          {
            values.map((v, i) => (
              <div class="border-t border-line pt-[22px]" data-reveal style={`--reveal-delay:${i * 120}ms`}>
                <div class="mb-[14px] font-serif text-[32px] text-brass">{v.numeral}</div>
                <h3 class="mb-3 font-serif text-[23px] font-semibold text-navy">{v.title}</h3>
                <p class="text-[clamp(14.5px,0.9vw,17.5px)] font-light leading-[1.7] text-ink">{v.body}</p>
              </div>
