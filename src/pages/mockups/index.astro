---
/** /mockups — design-preview gallery. Lets the client compare the three hero
    concepts (each a real, live page) plus the shared new elements: the moving
    practice-areas marquee, the reviews badge, and reveal-on-scroll animations. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewsBadge from '../../components/ReviewsBadge.astro';
import PracticeMarquee from '../../components/PracticeMarquee.astro';

const mockups = [
  {
    id: 'A',
    name: 'The Split',
    href: '/mockups/split',
    tag: 'Staff photo · two-column',
    blurb:
      'The themvp.com layout: headline and review badge on the left, the full staff photo framed on the right, over a navy starfield. Puts the team front-and-center.',
  },
  {
    id: 'B',
    name: 'The Spotlight',
    href: '/mockups/spotlight',
    tag: 'Full-bleed · cinematic',
    blurb:
      'The staff photo goes edge-to-edge as the backdrop, with a navy scrim carrying the headline on the left. The boldest, most photographic option.',
  },
  {
    id: 'C',
    name: 'The Classic',
    href: '/mockups/classic',
    tag: 'Marble columns · centered',
    blurb:
      'A refinement of today’s live hero — the marble columns stay, but the 5.0 review badge is promoted above the headline and everything reveals on scroll.',
  },
];
---

<BaseLayout title="Design previews | Kagasoff Law Firm">
  <!-- Intro -->
  <section class="starfield text-paper">
    <div class="mx-auto max-w-[1180px] px-5 py-16 text-center md:px-10 md:py-24">
      <p class="mb-5 text-xs uppercase tracking-[0.32em] text-brasslight" data-reveal>Internal · Design previews</p>
      <h1 class="mx-auto max-w-[760px] font-serif text-[38px] font-medium leading-[1.08] md:text-[58px]" data-reveal style="--reveal-delay:100ms">
        Three hero directions to choose from.
      </h1>
      <p class="mx-auto mt-6 max-w-[620px] text-[16px] font-light leading-[1.75] text-mist" data-reveal style="--reveal-delay:180ms">
        Each card below is a real, clickable page. They share the new pieces from your feedback —
        the moving practice-areas bar, the Google-review star badge with the staff photos, and
        the scroll-reveal animations. Open each one, then tell me which hero to ship.
      </p>
      <div class="mt-9 flex justify-center" data-reveal style="--reveal-delay:240ms">
        <ReviewsBadge count="291" people={[1, 2, 3, 4, 5]} />
      </div>
    </div>
  </section>

  <PracticeMarquee theme="navy" />

  <!-- Gallery -->
  <section class="mx-auto max-w-[1180px] px-5 py-16 md:px-10 md:py-24">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
      {
        mockups.map((m, i) => (
          <a href={m.href} class="mock-card group block" data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <div class="mock-thumb">
              <iframe src={m.href} title={`Preview of ${m.name}`} loading="lazy" scrolling="no" tabindex="-1"></iframe>
              <span class="mock-thumb-hover">Open preview →</span>
            </div>
            <div class="mt-5 flex items-center gap-3">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-navy font-serif text-[15px] font-semibold text-gold">{m.id}</span>
              <div>
                <h2 class="font-serif text-[24px] font-medium leading-none text-navy">{m.name}</h2>
                <div class="mt-1 text-[11px] uppercase tracking-[0.16em] text-brass">{m.tag}</div>
              </div>
            </div>
            <p class="mt-3 text-[14.5px] font-light leading-[1.7] text-ink">{m.blurb}</p>
            <span class="mt-4 inline-flex items-center gap-2 text-[13px] font-semibold uppercase tracking-[0.12em] text-brass">
              View full page
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </span>
          </a>
        ))
      }
    </div>

    <div class="mt-16 rounded-lg border border-line bg-cream/60 p-7 md:p-9" data-reveal>
      <h3 class="font-serif text-[24px] font-medium text-navy md:text-[28px]">What’s already live on the site</h3>
      <ul class="mt-4 grid gap-2.5 text-[14.5px] font-light leading-[1.6] text-ink md:grid-cols-2">
        <li>· <a href="/" class="text-brass underline decoration-brass/40 underline-offset-2">The home page</a> now has the moving practice-areas bar and the review badge in the hero.</li>
        <li>· Sections fade and slide up as you scroll (try scrolling the home page).</li>
        <li>· The star badge crops faces from the single staff photo — no new headshots needed.</li>
        <li>· All animations respect “reduce motion” accessibility settings.</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .mock-thumb {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--color-line);
    background: var(--color-navy);
    box-shadow: 0 24px 50px -28px rgba(22, 36, 61, 0.5);
    transition: box-shadow 0.3s, transform 0.3s, border-color 0.3s;
  }
  .mock-card:hover .mock-thumb {
    transform: translateY(-4px);
    border-color: var(--color-brasslight);
    box-shadow: 0 34px 64px -30px rgba(22, 36, 61, 0.6);
  }
  /* Render the live page at desktop width, then scale it down into the card. */
  .mock-thumb iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1280px;
    height: 880px;
    border: 0;
    transform: scale(0.278);
    transform-origin: top left;
    pointer-events: none;
  }
  .mock-thumb-hover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(16, 27, 48, 0.55);
    color: var(--color-paper);
    font-family: var(--font-sans);
    font-size: 14px;
    letter-spacing: 0.06em;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .mock-card:hover .mock-thumb-hover {
    opacity: 1;
  }
</style>
