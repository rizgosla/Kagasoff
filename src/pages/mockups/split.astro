---
/** MOCKUP A — "The Split" — themvp.com-style two-column hero: headline + review
    badge on the left, the staff photo panel on the right, over a navy starfield. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeMarquee from '../../components/PracticeMarquee.astro';
import ReviewsBadge from '../../components/ReviewsBadge.astro';
import MockupProof from '../../components/MockupProof.astro';
import MockupSwitcher from '../../components/MockupSwitcher.astro';
import PracticeCTA from '../../components/PracticeCTA.astro';
---

<BaseLayout title="Mockup A — The Split | Kagasoff Law Firm">
  <section class="starfield overflow-hidden text-paper">
    <div class="mx-auto grid max-w-[1180px] grid-cols-1 items-center gap-12 px-5 pb-16 pt-14 md:grid-cols-[1.05fr_0.95fr] md:gap-16 md:px-10 md:pb-24 md:pt-20">
      <!-- Left: copy -->
      <div data-reveal="left">
        <p class="mb-6 text-xs uppercase tracking-[0.32em] text-brasslight">Westminster · Serving California</p>
        <h1 class="font-serif text-[44px] font-medium leading-[1.04] tracking-[0.005em] md:text-[68px]">
          Orange County<br />
          <span class="text-gold">injury &amp; defense</span><br />
          attorneys.
        </h1>
        <p class="mt-7 max-w-[480px] text-[16px] font-light leading-[1.75] text-mist md:text-[17px]">
          From the courtroom to the negotiating table, the Kagasoff Law Firm brings disciplined,
          personal advocacy to every client — across seven practice areas.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <a href="tel:6572184947" class="lift inline-block rounded-[7px] bg-brass px-9 py-[18px] text-center text-[15px] font-semibold tracking-[0.04em] text-navy">Call (657) 218-4947</a>
          <a href="/contact" class="lift inline-block rounded-[7px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[15px] font-semibold tracking-[0.04em] text-paper">Free consultation</a>
        </div>
        <div class="mt-10">
          <ReviewsBadge count="291" people={[1, 2, 3, 4, 5]} />
        </div>
      </div>

      <!-- Right: staff photo panel -->
      <div class="relative" data-reveal="right" style="--reveal-delay:140ms">
        <div aria-hidden="true" class="pointer-events-none absolute -inset-3 rounded-[14px] border border-[rgba(201,190,159,0.4)] md:-inset-4"></div>
        <div class="relative overflow-hidden rounded-[10px] bg-navydark shadow-[0_40px_80px_-40px_rgba(0,0,0,0.7)]">
          <img src="/team.jpg" alt="The Kagasoff Law Firm team" class="h-full w-full object-cover" style="aspect-ratio:4/5;object-position:50% 35%" />
          <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-[rgba(16,27,48,0.85)] to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <div class="inline-flex items-center gap-2 rounded-full bg-[rgba(16,27,48,0.72)] px-4 py-2 text-[12px] tracking-[0.04em] text-paper backdrop-blur">
              <span class="h-1.5 w-1.5 rounded-full bg-gold"></span>
              A team that fights for you
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <PracticeMarquee theme="navy" />
  <MockupProof />
  <PracticeCTA />
  <MockupSwitcher current="A" />
</BaseLayout>
