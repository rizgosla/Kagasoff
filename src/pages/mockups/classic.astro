---
/** MOCKUP C — "The Classic" — an evolution of the current marble-columns hero:
    the review badge is promoted above the headline, layout stays centered and
    architectural. The safest step from today's live site. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeMarquee from '../../components/PracticeMarquee.astro';
import ReviewsBadge from '../../components/ReviewsBadge.astro';
import MockupProof from '../../components/MockupProof.astro';
import MockupSwitcher from '../../components/MockupSwitcher.astro';
import PracticeCTA from '../../components/PracticeCTA.astro';
---

<BaseLayout title="Mockup C — The Classic | Kagasoff Law Firm">
  <section class="relative overflow-hidden bg-navy text-paper">
    <img src="/hero.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover object-[50%_65%]" />
    <div class="absolute inset-0 bg-[rgba(22,36,61,0.78)]"></div>
    <div class="relative mx-auto max-w-[1180px] px-5 pb-16 pt-14 text-center md:px-10 md:pb-24 md:pt-[104px]">
      <div class="mb-9 flex justify-center" data-reveal>
        <ReviewsBadge count="291" people={[2, 3, 4]} />
      </div>
      <p class="mb-6 text-xs uppercase tracking-[0.32em] text-brasslight" data-reveal style="--reveal-delay:80ms">Serving California</p>
      <h1 class="mx-auto max-w-[820px] font-serif text-[40px] font-medium leading-[1.08] tracking-[0.005em] md:text-[70px] md:leading-[1.04]" data-reveal style="--reveal-delay:140ms">
        Trusted counsel<br />when it matters most.
      </h1>
      <div class="mx-auto my-9 h-0.5 w-[54px] bg-brass" data-reveal style="--reveal-delay:200ms"></div>
      <p class="mx-auto mb-10 max-w-[580px] text-[16px] font-light leading-[1.7] text-mist md:text-[17px]" data-reveal style="--reveal-delay:240ms">
        From the courtroom to the negotiating table, the Kagasoff Law Firm brings disciplined,
        personal advocacy to every client across seven practice areas.
      </p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:flex-wrap sm:justify-center" data-reveal style="--reveal-delay:300ms">
        <a href="tel:6572184947" class="lift inline-block w-full rounded-[7px] bg-brass px-9 py-[18px] text-center text-[15px] font-semibold tracking-[0.04em] text-navy sm:w-auto">Call (657) 218-4947</a>
        <a href="/contact" class="lift inline-block w-full rounded-[7px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[15px] font-semibold tracking-[0.04em] text-paper sm:w-auto">Request a free consultation</a>
      </div>
    </div>
  </section>

  <PracticeMarquee theme="navy" />
  <MockupProof />
  <PracticeCTA />
  <MockupSwitcher current="C" />
</BaseLayout>
