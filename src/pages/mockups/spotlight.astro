---
/** MOCKUP B — "The Spotlight" — full-bleed staff photo with a navy scrim and
    left-weighted headline + review badge. The most cinematic of the three. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PracticeMarquee from '../../components/PracticeMarquee.astro';
import ReviewsBadge from '../../components/ReviewsBadge.astro';
import MockupProof from '../../components/MockupProof.astro';
import MockupSwitcher from '../../components/MockupSwitcher.astro';
import PracticeCTA from '../../components/PracticeCTA.astro';
---

<BaseLayout title="Mockup B — The Spotlight | Kagasoff Law Firm">
  <section class="relative min-h-[560px] overflow-hidden bg-navydark text-paper md:min-h-[660px]">
    <img src="/team.jpg" alt="The Kagasoff Law Firm team" class="absolute inset-0 h-full w-full object-cover object-[70%_28%]" />
    <!-- scrims: darken left for text legibility + a bottom fade into the marquee -->
    <div class="absolute inset-0 bg-gradient-to-r from-[rgba(12,20,36,0.94)] via-[rgba(14,23,40,0.72)] to-[rgba(14,23,40,0.25)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-navy to-transparent"></div>

    <div class="relative mx-auto flex min-h-[560px] max-w-[1180px] flex-col justify-center px-5 py-16 md:min-h-[660px] md:px-10">
      <div class="max-w-[640px]" data-reveal>
        <p class="mb-6 text-xs uppercase tracking-[0.32em] text-brasslight">A Lawyer Who Fights For You</p>
        <h1 class="font-serif text-[46px] font-medium leading-[1.03] tracking-[0.005em] md:text-[76px]">
          Trusted counsel<br />when it matters most.
        </h1>
        <p class="mt-7 max-w-[500px] text-[16px] font-light leading-[1.75] text-mist md:text-[18px]">
          Boutique Orange County representation with the resources and resolve of a much larger firm —
          direct, attorney-led, and prepared to try every case.
        </p>
        <div class="mt-9 flex flex-col gap-4 sm:flex-row sm:flex-wrap">
          <a href="tel:6572184947" class="lift inline-block rounded-[7px] bg-brass px-9 py-[18px] text-center text-[15px] font-semibold tracking-[0.04em] text-navy">Call (657) 218-4947</a>
          <a href="/contact" class="lift inline-block rounded-[7px] border border-[rgba(250,248,243,0.45)] px-9 py-[18px] text-center text-[15px] font-semibold tracking-[0.04em] text-paper">Request a free consultation</a>
        </div>
        <div class="mt-10">
          <ReviewsBadge count="291" people={[2, 3, 4]} />
        </div>
      </div>
    </div>
  </section>

  <PracticeMarquee theme="navy" />
  <MockupProof />
  <PracticeCTA />
  <MockupSwitcher current="B" />
</BaseLayout>
