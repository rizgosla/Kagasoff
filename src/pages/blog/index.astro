---
/** Blog index — prerendered. Navy hero in the services-page style, then the
    published posts newest first. Drafts appear only in dev (with a tag). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = (await getCollection('posts', ({ data }) => !import.meta.env.PROD || !data.draft)).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
---

<BaseLayout
  title="Notes from the Firm — Kagasoff Law Firm"
  description="Plain-English answers to common legal questions from the attorneys at Kagasoff Law Firm in Westminster, Orange County."
>
  <!-- HERO -->
  <section class="starfield overflow-hidden text-paper">
    <div class="shell pb-12 pt-14 md:pb-[70px] md:pt-16">
      <p class="mb-5 text-[clamp(12px,0.72vw,14px)] uppercase tracking-[0.32em] text-brasslight" data-reveal>Insights</p>
      <h1 class="mb-[18px] font-serif text-[clamp(34px,5.1vw,66px)] font-medium leading-[1.06]" data-reveal style="--reveal-delay:80ms">
        Notes <span class="text-gold">from the firm.</span>
      </h1>
      <div class="mb-7 h-0.5 w-[54px] bg-brass" data-reveal style="--reveal-delay:130ms"></div>
      <p class="max-w-[62ch] text-[clamp(16px,1.05vw,20px)] font-light leading-[1.7] text-mist" data-reveal style="--reveal-delay:170ms">
        Straight answers to the questions clients ask us most, written in plain English.
      </p>
    </div>
  </section>

  <!-- POSTS -->
  <section class="bg-paper">
    <div class="shell py-14 md:py-[80px]">
      {
        posts.length > 0 ? (
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8 xl:grid-cols-3">
            {posts.map((post, i) => (
              <div data-reveal style={`--reveal-delay:${Math.min(i, 5) * 60}ms`}>
                <BlogPostCard
                  slug={post.id}
                  title={post.data.title}
                  summary={post.data.summary}
                  publishedDate={post.data.publishedDate}
                  coverImage={post.data.coverImage}
                  coverImageAlt={post.data.coverImageAlt}
                  draft={post.data.draft}
                />
              </div>
            ))}
          </div>
        ) : (
          <div class="popout mx-auto max-w-[620px] px-6 py-14 text-center md:px-10" data-reveal>
            <p class="mb-4 text-[12px] uppercase tracking-[0.32em] text-brass">Coming soon</p>
            <h2 class="mb-4 font-serif text-[clamp(28px,3vw,38px)] font-medium text-navy">New articles coming soon</h2>
            <div class="mx-auto mb-5 h-0.5 w-[54px] bg-brass"></div>
            <p class="text-[16px] font-light leading-[1.7] text-ink">
              We are preparing our first notes. In the meantime, if you have a question about your situation,
              call <a href="tel:6572184947" class="text-brass underline underline-offset-4">(657) 218-4947</a> for a free consultation.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
