---
/** Blog post — prerendered per published post (drafts included in dev only). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !import.meta.env.PROD || !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, summary, publishedDate, coverImage, coverImageAlt, draft } = post.data;
const { Content } = await render(post);

const dateLabel = publishedDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const iso = publishedDate.toISOString().slice(0, 10);
---

<BaseLayout title={`${title} — Kagasoff Law Firm`} description={summary}>
  <!-- ARTICLE HEADER -->
  <section class="bg-paper">
    <div class="shell pt-10 md:pt-14">
      <div class="blog-col">
        <a href="/blog" class="mb-8 inline-flex items-center gap-2 text-[12.5px] font-semibold uppercase tracking-[0.14em] text-brass">
          <span aria-hidden="true">&larr;</span> All articles
        </a>
        <div class="mb-4 flex flex-wrap items-center gap-3 text-[12.5px] uppercase tracking-[0.18em] text-brass">
          <time datetime={iso}>{dateLabel}</time>
          {
            draft && (
              <span class="rounded-full border border-brass/60 px-2.5 py-0.5 text-[10.5px] font-semibold tracking-[0.14em]">Draft</span>
            )
          }
        </div>
        <h1 class="mb-5 font-serif text-[clamp(34px,4.6vw,58px)] font-medium leading-[1.08] text-navy">{title}</h1>
        <div class="mb-6 h-0.5 w-[54px] bg-brass"></div>
        <p class="font-serif text-[clamp(20px,1.7vw,26px)] italic leading-[1.45] text-ink">{summary}</p>
      </div>

      {
        coverImage && (
          <figure class="mx-auto mt-10 max-w-[1000px]">
            <img
              src={coverImage}
              alt={coverImageAlt ?? ''}
              class="aspect-[16/9] w-full rounded-[10px] border border-line object-cover"
              decoding="async"
            />
          </figure>
        )
      }
    </div>
  </section>

  <!-- ARTICLE BODY -->
  <section class="bg-paper">
    <div class="shell pb-14 pt-10 md:pb-[70px] md:pt-12">
      <div class="blog-col">
        <div class="prose-blog">
          <Content />
        </div>

        <!-- Disclaimer -->
        <aside class="mt-14 rounded-[10px] border border-line bg-cream px-6 py-6 md:px-8" aria-label="Legal disclaimer">
          <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-brass">Please note</p>
          <p class="text-[14.5px] font-light leading-[1.75] text-ink">
            This article is general information, not legal advice. Reading it does not create an attorney&ndash;client
            relationship. For advice about your situation, contact the firm for a free consultation.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="starfield overflow-hidden text-paper">
    <div class="shell py-14 text-center md:py-[70px]">
      <h2 class="mb-3.5 font-serif text-[clamp(28px,3.2vw,44px)] font-medium">Have a <span class="text-gold">question?</span></h2>
      <p class="mb-[30px] text-[16px] font-light text-mist">Let's talk today. Your first consultation is free and confidential.</p>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:flex-wrap sm:justify-center">
        <a href="tel:6572184947" class="btn-brass lift inline-block w-full rounded-[8px] bg-brass px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] sm:w-auto">Call (657) 218-4947</a>
        <a href="/#contact" class="lift inline-block w-full rounded-[8px] border border-[rgba(250,248,243,0.4)] px-9 py-[18px] text-center text-[clamp(15px,0.9vw,17px)] font-semibold tracking-[0.04em] text-paper sm:w-auto">Send a message</a>
      </div>
    </div>
  </section>
</BaseLayout>
