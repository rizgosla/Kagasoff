---
/** Contact — "Plain English, legal structure." Hero (with a real-facts
    quick-contact panel, no stock imagery), an accessible client-side-
    validated consultation form that discloses non-delivery BEFORE the
    visitor types anything (not just after), and the office info column
    with a map placeholder.
    See design-system/kagasoff-law-firm/MASTER.md. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import SectionIndex from '../components/SectionIndex.astro';
import { practiceAreas } from '../data/practiceAreas';

const matterOptions = [...practiceAreas.map((a) => a.name), 'Not sure / other'];
const labelCls = 'mb-2xs block text-meta uppercase tracking-[0.08em] text-ink';
const errCls = 'mt-2xs hidden text-meta text-alert';
---

<BaseLayout
  title="Contact — Westminster, CA Attorney | Kagasoff Law Firm, A.P.C."
  description="Reach Westminster attorney Ashley Kagasoff at (657) 218-4947, or send the details of your case. Serving Orange County, California."
>
  <!-- HERO -->
  <section class="bg-paper">
    <div class="mx-auto grid max-w-page grid-cols-1 items-start gap-2xl px-lg py-section md:grid-cols-[1.3fr_1fr] md:px-2xl">
      <div data-reveal="left">
        <SectionIndex n={1} label="Contact" />
        <h1 class="max-w-measure font-serif text-h1 font-medium text-ink" data-reveal>
          Tell us what happened.
        </h1>
        <p class="mt-lg max-w-prose text-lead text-stone" data-reveal style="--reveal-delay:100ms">
          Call (657) 218-4947 to reach the Westminster, CA office directly, or send the details below.
          If your matter is urgent, calling is fastest.
        </p>
      </div>

      <div
        class="rounded-md border border-line bg-sand px-lg py-lg shadow-card"
        data-reveal="right"
        style="--reveal-delay:120ms"
      >
        <p class="text-eyebrow uppercase text-clay">Reach us directly</p>
        <dl class="mt-lg flex flex-col gap-md">
          <div>
            <dt class="text-meta text-stone">Phone</dt>
            <dd>
              <a href="tel:+16572184947" class="font-serif text-h3 font-semibold text-clay underline">
                (657) 218-4947
              </a>
            </dd>
          </div>
          <div class="border-t border-line pt-md">
            <dt class="text-meta text-stone">Office</dt>
            <dd class="font-serif text-h3 font-semibold text-ink">Westminster, CA</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- FORM + INFO -->
  <section class="bg-sand">
    <div class="mx-auto grid max-w-page grid-cols-1 items-start gap-2xl px-lg py-section md:grid-cols-[1.4fr_1fr] md:px-2xl">
      <!-- FORM -->
      <div data-reveal="left">
        <SectionIndex n={2} label="Request a consultation" />

        <form id="consult-form" novalidate>
          <h2 class="font-serif text-h2 font-medium text-ink">Send us the details</h2>
          <p class="mt-sm text-meta text-stone">
            Fields marked <span aria-hidden="true" class="text-clay">*</span><span class="sr-only"> (required)</span> are required.
          </p>

          <!-- Surfaced BEFORE the fields, not just after a failed or valid
               submit: a stressed visitor should learn this before typing out
               their situation, not after. Wording matches the post-submit
               panel below. -->
          <div class="mt-lg rounded-md border border-clay bg-paper px-md py-sm text-body text-ink">
            This form can&rsquo;t send messages yet — nothing you type below will be sent. Call
            <a href="tel:+16572184947" class="text-clay underline">(657) 218-4947</a> to reach us directly;
            a real person will pick up.
          </div>

          <div
            id="form-summary"
            aria-live="polite"
            class="mt-lg hidden rounded-md border border-alert bg-paper px-md py-sm text-meta text-ink"
          >
            Please fix the highlighted fields below before sending.
          </div>

          <div class="mt-lg grid grid-cols-1 gap-lg sm:grid-cols-2">
            <div>
              <label class={labelCls} for="name">Name <span aria-hidden="true" class="text-clay">*</span></label>
              <input
                class="fld"
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
                aria-required="true"
                aria-describedby="name-error"
              />
              <p id="name-error" class={errCls}>Enter your full name.</p>
            </div>
            <div>
              <label class={labelCls} for="phone">Phone <span aria-hidden="true" class="text-clay">*</span></label>
              <input
                class="fld"
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                required
                aria-required="true"
                aria-describedby="phone-error"
              />
              <p id="phone-error" class={errCls}>Enter a phone number we can reach you at.</p>
            </div>
          </div>

          <div class="mt-lg">
            <label class={labelCls} for="email">Email</label>
            <input
              class="fld"
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              aria-describedby="email-error"
            />
            <p id="email-error" class={errCls}>Enter a valid email address, or leave this blank.</p>
          </div>

          <div class="mt-lg">
            <label class={labelCls} for="area">Matter type</label>
            <select class="fld" id="area" name="area">
              <option value="">Select a matter type</option>
              {matterOptions.map((o) => <option value={o}>{o}</option>)}
            </select>
          </div>

          <div class="mt-lg">
            <label class={labelCls} for="message">How can we help? <span aria-hidden="true" class="text-clay">*</span></label>
            <textarea
              class="fld"
              id="message"
              name="message"
              required
              aria-required="true"
              aria-describedby="message-error"
            ></textarea>
            <p id="message-error" class={errCls}>Briefly describe your situation.</p>
          </div>

          <button
            type="submit"
            class="btn-clay lift mt-xl inline-flex items-center justify-center rounded-md bg-clay px-lg py-md text-body font-semibold"
          >
            Send message
          </button>

          <p class="mt-lg max-w-measure text-meta text-stone">
            Submitting this form does not create an attorney&ndash;client relationship, and information
            sent through it is not confidential until an engagement is established. Prefer to talk now?
            Call <a href="tel:+16572184947" class="text-clay underline">(657) 218-4947</a>.
          </p>
        </form>

        <!-- Honest no-delivery state: shown after a valid submit. Never claims the
             message was sent — this form has no backend yet. -->
        <div id="no-delivery" class="hidden rounded-md border border-clay bg-paper px-lg py-xl" aria-live="polite">
          <h2 id="no-delivery-heading" tabindex="-1" class="font-serif text-h3 font-semibold text-ink">
            This form can&rsquo;t send messages yet.
          </h2>
          <p class="mt-sm max-w-measure text-body text-stone">
            Your information was not sent — this contact form is not yet connected to a delivery
            service.
            <!-- NEEDS-CLIENT: form delivery method (Netlify Forms, Formspree, or an Astro API route) -->
            Please call us directly instead; a real person will pick up.
          </p>
          <div class="mt-lg flex flex-col gap-md sm:flex-row sm:flex-wrap">
            <a
              href="tel:+16572184947"
              class="btn-clay lift inline-flex items-center justify-center rounded-md bg-clay px-lg py-md text-body font-semibold"
            >
              Call (657) 218-4947
            </a>
            <button
              type="button"
              id="reset-form"
              class="lift inline-flex items-center justify-center rounded-md border border-ink px-lg py-md text-body font-semibold text-ink"
            >
              Back to the form
            </button>
          </div>
        </div>
      </div>

      <!-- INFO -->
      <div data-reveal="right" style="--reveal-delay:120ms">
        <SectionIndex n={3} label="Office" />
        <h2 class="sr-only">Office</h2>
        <div class="rounded-md border border-line bg-paper px-lg py-lg shadow-card">
          <div class="font-serif text-h3 font-semibold text-ink">
            <!-- NEEDS-CLIENT: confirm suite number — the live site's Contact page shows
                 "Suite B7" while every other reference (repo, GBP name/phone source)
                 shows "Suite D4". Confirm against the Google Business Profile. -->
            14541 Brookhurst St, Suite D4<br />Westminster, CA 92683
          </div>
          <div class="mt-lg text-body text-stone">
            <p>Phone: <a href="tel:+16572184947" class="text-clay underline">(657) 218-4947</a></p>
            <p class="mt-2xs">Fax: 657-900-2884</p>
            <p class="mt-2xs">
              Hours: not yet published — call to confirm availability.
              <!-- NEEDS-CLIENT: business hours -->
            </p>
          </div>
        </div>

        <!-- NEEDS-CLIENT: office map embed -->
        <Placeholder label="Map — Westminster office" class="mt-lg aspect-[4/3] rounded-md" />
        <p class="sr-only">Office map placeholder — a live map is not yet available.</p>
      </div>
    </div>
  </section>

  <script>
    // Accessible client-side validation. This form has no delivery backend
    // (see NEEDS-CLIENT above), so a passed validation shows an honest
    // no-delivery notice rather than a fake "message sent" confirmation.
    const form = document.getElementById('consult-form') as HTMLFormElement | null;
    const summary = document.getElementById('form-summary');
    const noDelivery = document.getElementById('no-delivery');
    const noDeliveryHeading = document.getElementById('no-delivery-heading');
    const resetBtn = document.getElementById('reset-form');

    interface Rule {
      id: string;
      errId: string;
      test: (value: string) => boolean;
    }

    const rules: Rule[] = [
      { id: 'name', errId: 'name-error', test: (v) => v.trim().length > 0 },
      { id: 'phone', errId: 'phone-error', test: (v) => (v.match(/\d/g) || []).length >= 10 },
      {
        id: 'email',
        errId: 'email-error',
        test: (v) => v.trim() === '' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim()),
      },
      { id: 'message', errId: 'message-error', test: (v) => v.trim().length > 0 },
    ];

    function validate(rule: Rule): boolean {
      const el = document.getElementById(rule.id) as HTMLInputElement | HTMLTextAreaElement | null;
      const err = document.getElementById(rule.errId);
      if (!el) return true;
      const ok = rule.test(el.value);
      el.setAttribute('aria-invalid', ok ? 'false' : 'true');
      err?.classList.toggle('hidden', ok);
      return ok;
    }

    rules.forEach((rule) => {
      document.getElementById(rule.id)?.addEventListener('blur', () => validate(rule));
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const outcomes = rules.map((rule) => ({ rule, ok: validate(rule) }));
      const firstInvalid = outcomes.find((o) => !o.ok);

      if (firstInvalid) {
        summary?.classList.remove('hidden');
        (document.getElementById(firstInvalid.rule.id) as HTMLElement | null)?.focus();
        return;
      }

      summary?.classList.add('hidden');
      form.classList.add('hidden');
      noDelivery?.classList.remove('hidden');
      noDeliveryHeading?.focus();
    });

    resetBtn?.addEventListener('click', () => {
      noDelivery?.classList.add('hidden');
      form?.classList.remove('hidden');
      form?.reset();
      rules.forEach((rule) => {
        document.getElementById(rule.id)?.setAttribute('aria-invalid', 'false');
        document.getElementById(rule.errId)?.classList.add('hidden');
      });
      summary?.classList.add('hidden');
      document.getElementById('name')?.focus();
    });
  </script>
</BaseLayout>
