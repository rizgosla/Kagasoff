---
/** Practice-area detail — ONE template → all 7 pages, in the "plain English,
    legal structure" direction: ink hero, sticky sidebar (all areas + a
    consultation card), the ruled-margin § index on every major section,
    the "how we can help" content, matter list, shared four-step process,
    attorney callout, related areas, and a closing consultation prompt.
    See design-system/kagasoff-law-firm/MASTER.md. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import SectionIndex from '../../components/SectionIndex.astro';
import PracticeCTA from '../../components/PracticeCTA.astro';
import { practiceAreas, process } from '../../data/practiceAreas';
import type { PracticeArea } from '../../data/practiceAreas';

export function getStaticPaths() {
  return practiceAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

interface Props {
  area: PracticeArea;
}

const { area } = Astro.props;
const related = practiceAreas.filter((a) => a.slug !== area.slug);

/** Cuts a string to a max length at the last whole word, so meta descriptions
    stay inside the ~155-char SERP budget instead of getting cut mid-word. */
function truncate(str: string, max: number) {
  if (str.length <= max) return str;
  const cut = str.slice(0, max);
  const lastSpace = cut.lastIndexOf(' ');
  return `${cut.slice(0, lastSpace > 0 ? lastSpace : max).trimEnd()}…`;
}

// Per-area SEO — every value below is derived from this area's own fields,
// so each of the 7 pages gets a unique title and description. The fixed
// suffix is kept short so the practice-area name doesn't push past the
// ~60-char SERP truncation point; the full legal name still lives in OG
// and JSON-LD.
const title = `${area.name} Attorney | Westminster, CA — Kagasoff Law`;
const descSuffix = ' Free consultation — call (657) 218-4947.';
const description = `${truncate(area.blurb, 155 - descSuffix.length)}${descSuffix}`;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const homeUrl = new URL('/', Astro.site).href;

const serviceSchema = {
  '@type': 'Service',
  serviceType: area.name,
  name: `${area.name} — Kagasoff Law Firm, A.P.C.`,
  description: area.blurb,
  url: pageUrl,
  provider: {
    '@type': 'LegalService',
    '@id': `${Astro.site}#organization`,
    name: 'Kagasoff Law Firm, A.P.C.',
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'Orange County, California' },
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: homeUrl },
    { '@type': 'ListItem', position: 2, name: 'Practice areas' },
    { '@type': 'ListItem', position: 3, name: area.name, item: pageUrl },
  ],
};

const schema = {
  '@context': 'https://schema.org',
  '@graph': [serviceSchema, breadcrumbSchema],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- HERO -->
  <section class="overflow-hidden bg-ink text-paper">
    <div class="mx-auto max-w-page px-lg pb-2xl pt-xl md:px-2xl md:pb-3xl md:pt-2xl">
      <nav aria-label="Breadcrumb" data-reveal>
        <ol class="flex flex-wrap items-center gap-xs text-meta text-mist">
          <li><a href="/" class="underline decoration-mist/50 underline-offset-2 hover:text-paper hover:decoration-paper">Home</a></li>
          <li aria-hidden="true">/</li>
          <li>Practice areas</li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-paper">{area.name}</li>
        </ol>
      </nav>

      <div class="mt-xl" data-reveal style="--reveal-delay:60ms">
        <SectionIndex n={1} label="Practice area" dark />
      </div>
      <h1 class="text-h1 font-serif font-medium text-paper" data-reveal style="--reveal-delay:80ms">{area.name}</h1>
      <p class="mt-lg max-w-prose text-lead font-light text-mist" data-reveal style="--reveal-delay:120ms" set:html={area.blurb} />
      <p class="mt-sm text-meta text-mist" data-reveal style="--reveal-delay:140ms">Serving Westminster and Orange County, California.</p>

      <div class="mt-xl flex flex-col gap-md sm:flex-row sm:flex-wrap" data-reveal style="--reveal-delay:160ms">
        <a href="tel:+16572184947" class="btn-clay lift inline-flex items-center justify-center rounded-md bg-clay px-lg py-sm text-center text-body font-semibold tracking-wide">Call (657) 218-4947</a>
        <a href="/contact/" class="lift inline-flex items-center justify-center rounded-md border border-paper/40 px-lg py-sm text-center text-body font-semibold tracking-wide text-paper">Request a consultation</a>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <section class="bg-paper">
    <div class="mx-auto grid max-w-page grid-cols-1 items-start gap-2xl px-lg py-2xl md:grid-cols-[0.27fr_0.73fr] md:gap-2xl md:px-2xl md:py-3xl">
      <!-- SIDEBAR -->
      <aside class="md:sticky md:top-lg" data-reveal="left">
        <p class="mb-md text-eyebrow font-sans font-semibold uppercase text-clay">Practice areas</p>
        <nav aria-label="Practice areas">
          <div class="flex flex-col">
            {
              practiceAreas.map((a) => {
                const active = a.slug === area.slug;
                return (
                  <a
                    href={`/practice/${a.slug}/`}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'sidelink border-l-2 px-md py-sm font-serif text-lead',
                      active
                        ? 'border-clay bg-sand text-ink'
                        : 'border-line text-stone',
                    ]}
                  >
                    {a.name}
                  </a>
                );
              })
            }
          </div>
        </nav>

        <!-- Consultation card -->
        <div class="mt-xl rounded-md bg-ink p-lg text-paper">
          <p class="mb-xs text-h3 font-serif">Free consultation</p>
          <p class="mb-lg text-meta font-light text-mist">
            We'll review your situation and tell you honestly how we can help.
          </p>
          <a href="tel:+16572184947" class="btn-clay lift block rounded-md bg-clay px-lg py-sm text-center text-meta font-semibold tracking-wide">Call (657) 218-4947</a>
        </div>
      </aside>

      <!-- CONTENT -->
      <div>
        <div data-reveal>
          <SectionIndex n={2} label="Overview" />
        </div>
        <h2 class="mb-lg text-h2 font-serif font-medium text-ink" data-reveal>How we can help</h2>
        {area.overview.map((p) => <p class="mb-lg text-body font-light leading-relaxed text-ink" data-reveal set:html={p} />)}

        <div class="mt-2xl" data-reveal>
          <SectionIndex n={3} label="Scope" />
        </div>
        <h2 class="mb-lg text-h2 font-serif font-medium text-ink" data-reveal set:html={area.casesHeading} />
        <div class="mb-2xl grid grid-cols-1 gap-x-2xl gap-y-sm sm:grid-cols-2" data-reveal>
          {
            area.cases.map((c) => (
              <div class="flex items-baseline gap-sm text-body text-ink">
                <span class="text-clay" aria-hidden="true">—</span>
                <span set:html={c} />
              </div>
            ))
          }
        </div>

        <div class="mt-2xl" data-reveal>
          <SectionIndex n={4} label="Process" />
        </div>
        <h2 class="mb-lg text-h2 font-serif font-medium text-ink" data-reveal>What to expect</h2>
        <div class="border-t border-line" data-reveal>
          {
            process.map((step, i) => (
              <div class="grid grid-cols-[var(--spacing-2xl)_1fr] gap-md border-b border-line py-lg">
                <div class="font-serif text-h3 text-clay">{String(i + 1).padStart(2, '0')}</div>
                <div>
                  <p class="mb-xs text-body font-semibold text-ink" set:html={step.title} />
                  <p class="text-meta font-light leading-relaxed text-stone" set:html={step.body} />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ATTORNEY CALLOUT -->
  <section class="bg-inkdeep text-paper">
    <div class="mx-auto grid max-w-page grid-cols-1 items-center gap-xl px-lg py-2xl md:grid-cols-[0.62fr_1.38fr] md:gap-2xl md:px-2xl md:py-3xl">
      <div class="relative" data-reveal="left">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute rounded-md border border-claylight/40"
          style="inset: var(--spacing-md) calc(var(--spacing-md) * -1) calc(var(--spacing-md) * -1) var(--spacing-md)"
        />
        <Photo src="/ashley-portrait.jpg" alt="Ashley Kagasoff, attorney at Kagasoff Law Firm, A.P.C." dark position="50% 22%" class="aspect-[4/5] w-full rounded-md" />
      </div>
      <div data-reveal="right" style="--reveal-delay:120ms">
        <SectionIndex n={5} label="Handled personally" dark />
        <h2 class="mb-lg mt-lg text-h2 font-serif font-medium leading-tight text-paper">
          Your case, worked directly by <span class="text-claylight">Ashley Kagasoff.</span>
        </h2>
        <p class="mb-xl max-w-prose text-body font-light leading-relaxed text-mist">
          No handoffs to junior associates. With over 17 years of advocacy and a rare view from both
          sides of the courtroom, Ashley prepares every {area.name.toLowerCase()} matter as if it will
          be tried — because that readiness is what earns the strongest outcomes.
        </p>
        <a href="/about/" class="lift inline-block border-b border-claylight pb-2xs text-meta font-semibold tracking-wide text-claylight">Meet the attorney →</a>
      </div>
    </div>
  </section>

  <!-- RELATED PRACTICE AREAS -->
  <section class="border-t border-line bg-sand">
    <div class="mx-auto max-w-page px-lg py-2xl md:px-2xl md:py-3xl">
      <div data-reveal>
        <SectionIndex n={6} label="Explore more" />
      </div>
      <h2 class="mb-xl text-h2 font-serif font-medium text-ink" data-reveal>Other ways we can help</h2>
      <div class="grid grid-cols-1 gap-md sm:grid-cols-2 lg:grid-cols-3">
        {
          related.map((a, i) => (
            <a
              href={`/practice/${a.slug}/`}
              class="related-card group flex flex-col rounded-md border border-line bg-paper p-lg"
              data-reveal
              style={`--reveal-delay:${(i % 3) * 90}ms`}
            >
              <h3 class="text-h3 font-serif font-semibold leading-tight text-ink">{a.name}</h3>
              <p class="mt-sm flex-1 text-meta font-light leading-relaxed text-stone" set:html={a.short} />
              <span class="mt-lg inline-flex items-center gap-xs text-eyebrow font-sans font-semibold uppercase text-clay">
                View {a.name}
                <span class="inline-block transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <PracticeCTA
    n={7}
    eyebrow="Get in touch"
    heading={`Have a ${area.name.toLowerCase()} matter?`}
    sub="Let's talk today. Your first consultation is free and confidential."
  />
</BaseLayout>
